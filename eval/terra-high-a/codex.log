"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import sys,math,json
from pathlib import Path
ROOT=Path(__file__).resolve().parents[5]; sys.path.insert(0,str(ROOT/'tools/solidworks'))
import numpy as np
from scipy.spatial import cKDTree
import swkit as k
from swkit import *
from swfea import PETG,static
k.pin_export_prefs=lambda sw: None
OUT=ROOT/'cad/_wip/sw-eval/terra-high-a'; RUN=Path(__file__).resolve().parent
with job(wait_s=1800) as j:
 j.simulation(); rows=[]
 for name,el,nn,washer in [('RR3',3.,26000,False),('RR22',2.2,46000,False),('RR17',1.7,90000,False),('RW22',2.2,50000,True)]:
  d=open_doc(j.sw,OUT/('bracket_reinforced_support.SLDPRT' if washer else 'bracket_reinforced.SLDPRT')); d.ForceRebuild3(False)
  if washer:
   fixed=[]; load=[]
   for x in (25,65):
    for y in (10,40):
     fs=pick(d,kind='plane',normal=(0,0,1),at=(x+3.3,y,5.9)); expect('washer ring',len(fs),1,0); fixed+=fs
   for a in (45,135,225,315):
    y=25+15.5*math.cos(math.radians(a)); z=28+15.5*math.sin(math.radians(a))
    fs=pick(d,kind='plane',normal=(-1,0,0),at=(.1,y+2.5,z)); expect('motor ring',len(fs),1,0); load+=fs
   loads=[('normal',load,150)]
  else:
   fixed=pick(d,kind='cyl',r=2.75); holes=pick(d,kind='cyl',r=1.7)
   expect('fixed',len(fixed),4,0); expect('motor holes',len(holes),4,0); loads=[]
   for f in holes:
    b=face_info(f)['box']; y=(b[1]+b[4])/2; z=(b[2]+b[5])/2
    loads.append(('remote',[f],(4,y,z),(37.5,0,0),(0,0,0)))
  print('PREDICT',name,nn,'nodes 2.5mm displacement peak motor or root',flush=True)
  r=static(j,d,name,PETG,fixtures=[('fixed',fixed)],loads=loads,el=el,max_nodes=199999)
  print('PREDICTION_CHECK',r.nodes,r.max_disp(),r.reaction,flush=True)
  if r.nodes>2*nn or r.nodes<nn/2 or r.max_disp()>7.5 or r.max_disp()<2.5/3:
   print('STOP prediction mismatch: stress not inspected',flush=True); break
  keep=cKDTree(r.fixed_pts).query(r.pos)[0]>=6
  dirs={}
  for label,n in [('X',(1,0,0)),('Y',(0,1,0)),('Z',(0,0,1))]: dirs[label]={'tension':r.layer_stress(n,keep),'shear':r.layer_shear(n,keep)}
  row={'study':name,'el':el,'nodes':r.nodes,'peak':r.peak(keep),'all':float(r.vm.max()),'dirs':dirs,'disp':r.max_disp(),'reaction':r.reaction}
  rows.append(row); print('ROW',row,flush=True)
  np.savez_compressed(RUN/(name+'.npz'),pos=r.pos,s=r.s,disp=r.disp,reaction=r.reaction)
  (RUN/'reinforced_compare_rows.json').write_text(json.dumps(rows,indent=2),encoding='utf-8')
  close(j.sw,d)
