+++ b/tools/solidworks/playbook/eval/luna-b/b1_hub.py
@@ -0,0 +1,156 @@
+"""B1: scripted hub model, with dimensions and volumes checked against the written specification."""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+import trimesh
+from scipy.integrate import quad
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swkit import MID, Sk, bbox, bodies, expect, export, extrude, feature_errors, face_info, job, list_faces, new_part, pick, plane, save, single_body, volume  # noqa: E402
+
+
+def hand_values():
+    # Keyway: only the rectangular area outside the existing 10 mm bore adds removed volume.
+    x0 = math.sqrt(25 - 1.5 ** 2)
+    bore_overlap = 3 * x0 + quad(lambda x: 2 * math.sqrt(25 - x * x), x0, 5.0, epsabs=1e-12)[0]
+    key_extra_area = 3 * 6.4 - bore_overlap
+    # The radial screw bore removes the shell between the 5 mm bore and 13 mm boss over its circular section.
+    screw_removed = quad(
+        lambda x: 2 * math.sqrt(4 - x * x) * (math.sqrt(169 - x * x) - math.sqrt(25 - x * x)),
+        -2.0, 2.0, epsabs=1e-11,
+    )[0]
+    total = (math.pi * 30 ** 2 * 5 + math.pi * 13 ** 2 * 20 - math.pi * 5 ** 2 * 25
+             - 6 * math.pi * 2.25 ** 2 * 5 - 2 * math.pi * 2.75 ** 2 * 5
+             - key_extra_area * 25 - screw_removed)
+    return total, key_extra_area * 25, screw_removed
+
+
+def center_of_face(f):
+    i = face_info(f)
+    return [(i['box'][k] + i['box'][k + 3]) / 2 for k in range(3)]
+
+
+def main():
+    expected, key_dv, screw_dv = hand_values()
+    print(f'HAND B1 volume {expected:.6f} mm3; keyway extra {key_dv:.6f}; set-screw bore {screw_dv:.6f}', flush=True)
+    path = CAD / 'hub.SLDPRT'
+    with job(wait_s=1800) as j:
+        d = new_part(j.sw, path)
+
+        with Sk(d, plane(d, 'Z', 2.5, 'FLANGE_P'), 'FLANGE') as s:
+            s.circle((0, 0, 2.5), 30.0)
+        extrude(d, s.feat, 'FLANGE', 5.0, mode=MID, expect_dv=math.pi * 30 ** 2 * 5)
+        save(d)
+
+        with Sk(d, plane(d, 'Z', 15.0, 'BOSS_P'), 'BOSS') as s:
+            s.circle((0, 0, 15.0), 13.0)
+        extrude(d, s.feat, 'BOSS', 20.0, mode=MID, expect_dv=math.pi * 13 ** 2 * 20)
+        save(d)
+
+        with Sk(d, plane(d, 'Z', 12.5, 'BORE_P'), 'BORE') as s:
+            s.circle((0, 0, 12.5), 5.0)
+        extrude(d, s.feat, 'BORE', 27.0, cut=True, mode=MID, expect_dv=math.pi * 5 ** 2 * 25)
+        save(d)
+
+        with Sk(d, plane(d, 'Z', 12.5, 'KEYWAY_P'), 'KEYWAY') as s:
+            s.rect((0, -1.5, 12.5), (6.4, 1.5, 12.5))
+        extrude(d, s.feat, 'KEYWAY', 27.0, cut=True, mode=MID, expect_dv=key_dv)
+        save(d)
+
+        with Sk(d, plane(d, 'Z', 2.5, 'BOLT_P'), 'BOLT_HOLES') as s:
+            for deg in range(0, 360, 60):
+                a = math.radians(deg)
+                s.circle((22.0 * math.cos(a), 22.0 * math.sin(a), 2.5), 2.25)
+        extrude(d, s.feat, 'BOLT_HOLES', 5.0, cut=True, mode=MID,
+                expect_dv=6 * math.pi * 2.25 ** 2 * 5)
+        save(d)
+
+        with Sk(d, plane(d, 'Z', 2.5, 'DOWEL_P'), 'DOWEL_HOLES') as s:
+            s.circle((0, 15.0, 2.5), 2.75)
+            s.circle((0, -15.0, 2.5), 2.75)
+        extrude(d, s.feat, 'DOWEL_HOLES', 5.0, cut=True, mode=MID,
+                expect_dv=2 * math.pi * 2.75 ** 2 * 5)
+        save(d)
+
+        with Sk(d, plane(d, 'Y', 7.0, 'SETSCREW_P'), 'SETSCREW') as s:
+            s.circle((0, 7.0, 22.6), 2.0)
+        extrude(d, s.feat, 'SETSCREW', 14.0, cut=True, mode=MID, expect_dv=screw_dv)
+        save(d)
+
+        if len(feature_errors(d)):
+            raise RuntimeError(f'feature errors: {feature_errors(d)}')
+        single_body(d)
+        expect('hub volume mm3', volume(d), expected, 0.001)
+        b = bbox(d)
+        for k, want in enumerate((-30, -30, 0, 30, 30, 25)):
+            expect(f'hub box[{k}] mm', b[k], want, 0.01)
+
+        # Verify hole radii and centers from the final cylindrical faces, not from the feature sketch alone.
+        bolt_faces = pick(d, kind='cyl', r=2.25)
+        dowel_faces = pick(d, kind='cyl', r=2.75)
+        expect('bolt-hole cylindrical faces', len(bolt_faces), 6, 0)
+        expect('dowel-hole cylindrical faces', len(dowel_faces), 2, 0)
+        bolt_centers = sorted((round(center_of_face(f)[0], 2), round(center_of_face(f)[1], 2)) for f in bolt_faces)
+        want_bolts = sorted((round(22 * math.cos(math.radians(a)), 2), round(22 * math.sin(math.radians(a)), 2))
+                            for a in range(0, 360, 60))
+        if bolt_centers != want_bolts:
+            raise RuntimeError(f'bolt centers read from final solid: {bolt_centers}, expected {want_bolts}')
+        dowel_centers = sorted((round(center_of_face(f)[0], 2), round(center_of_face(f)[1], 2)) for f in dowel_faces)
+        if dowel_centers != [(0.0, -15.0), (0.0, 15.0)]:
+            raise RuntimeError(f'dowel centers read from final solid: {dowel_centers}')
+
+        set_faces = pick(d, kind='cyl', r=2.0)
+        expect('set-screw cylindrical faces', len(set_faces), 1, 0)
+        set_i = face_info(set_faces[0])
+        expect('set-screw axis X center', (set_i['box'][0] + set_i['box'][3]) / 2, 0.0, 0.01)
+        expect('set-screw axis Z center', (set_i['box'][2] + set_i['box'][5]) / 2, 22.6, 0.01)
+        key_floor = pick(d, kind='plane', at=(6.4, 0, 12.5))
+        expect('keyway floor face at X=6.4', len(key_floor), 1, 0)
+        key_i = face_info(key_floor[0])['box']
+        expect('keyway floor width mm', key_i[4] - key_i[1], 3.0, 0.02)
+        save(d)
+        export(j.sw, d, CAD / 'hub.step')
+        export(j.sw, d, CAD / 'hub.stl')
+        sw_volume, sw_box, bdy = volume(d), bbox(d), bodies(d)
+
+    mesh = trimesh.load(CAD / 'hub.stl', force='mesh')
+    stl_box = np.asarray(mesh.bounds).reshape(-1).tolist()
+    stl_volume = float(mesh.volume)
+    if not mesh.is_watertight or len(mesh.split(only_watertight=False)) != 1:
+        raise RuntimeError(f'STL must be watertight and one shell; watertight={mesh.is_watertight}, shells={len(mesh.split(only_watertight=False))}')
+    if abs(stl_volume - sw_volume) / sw_volume > 0.005:
+        raise RuntimeError(f'STL volume {stl_volume} differs from SolidWorks {sw_volume}')
+    if max(abs(a - b) for a, b in zip(stl_box, sw_box)) > 0.1:
+        raise RuntimeError(f'STL box {stl_box} differs from SolidWorks {sw_box}')
+    step_text = (CAD / 'hub.step').read_text(encoding='ascii', errors='ignore')
+    if not any('.MILLI.' in line and 'SI_UNIT' in line for line in step_text.splitlines()):
+        raise RuntimeError('STEP length unit is not SI_UNIT .MILLI. METRE')
+
+    spec_questions = [
+        'The two Ø5.5 dowel holes on the Ø30 circle overlap the Ø26 boss footprint by 0.75 mm radially; I kept them through the flange thickness only, as specified, so their top openings meet the boss underside.'
+    ]
+    result = {
+        'volume_mm3': sw_volume,
+        'hand_volume_mm3': expected,
+        'mass_g': sw_volume * 0.00119,
+        'bbox_mm': sw_box,
+        'bodies': bdy,
+        'stl_watertight': bool(mesh.is_watertight),
+        'stl_volume_mm3': stl_volume,
+        'stl_bbox_mm': stl_box,
+        'spec_questions': spec_questions,
+        'status': 'complete',
+        'notes': 'All dimensions, feature errors, body count, volume, STEP units and STL checks recorded in REPORT.md.'
+    }
+    (RUN / 'b1_result.json').write_text(json.dumps(result, indent=2), encoding='utf-8')
+    print(json.dumps(result, indent=2), flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/solidworks/playbook/eval/luna-b/b1_measure.py b/tools/solidworks/playbook/eval/luna-b/b1_measure.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e104c03bb91349f131c76ddced7377030ce9e55
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-b/b1_measure.py
@@ -0,0 +1,55 @@
+"""Measure dimensions on the finished B1 solid after reopen."""
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swkit import expect, face_info, job, open_doc, pick, volume, bbox, feature_errors, single_body, bodies, close  # noqa: E402
+
+
+def main():
+    with job(wait_s=1800) as j:
+        d = open_doc(j.sw, CAD / 'hub.SLDPRT')
+        d.ForceRebuild3(False)
+        if feature_errors(d):
+            raise RuntimeError(f'feature errors after reopen: {feature_errors(d)}')
+        single_body(d)
+        flange = pick(d, kind='cyl', r=30.0)
+        boss = pick(d, kind='cyl', r=13.0)
+        bore = pick(d, kind='cyl', r=5.0)
+        screw = pick(d, kind='cyl', r=2.0)
+        expect('outer flange cylinder', len(flange), 1, 0)
+        expect('boss cylinder', len(boss), 1, 0)
+        expect('bore cylinder face(s)', len(bore), 1, 0)
+        expect('set-screw cylinder face', len(screw), 1, 0)
+        fi, bi, boi, si = [face_info(fs[0]) for fs in (flange, boss, bore, screw)]
+        expect('flange thickness from finished cylindrical face', fi['box'][5] - fi['box'][2], 5.0, 0.01)
+        expect('boss height from finished cylindrical face', bi['box'][5] - bi['box'][2], 20.0, 0.01)
+        expect('boss radius from finished face', bi['r'], 13.0, 0.01)
+        expect('bore radius from finished face', boi['r'], 5.0, 0.01)
+        flange_top = pick(d, kind='plane', at=(27, 0, 5))
+        boss_top = pick(d, kind='plane', at=(10, 0, 25))
+        expect('flange top face at Z5', len(flange_top), 1, 0)
+        expect('boss top face at Z25', len(boss_top), 1, 0)
+        key = pick(d, kind='plane', at=(6.4, 0, 12.5))
+        expect('keyway floor face', len(key), 1, 0)
+        ki = face_info(key[0])['box']
+        expect('keyway length from finished face', ki[5] - ki[2], 25.0, 0.02)
+        b = bbox(d)
+        result = {
+            'flange_outer_face': fi, 'boss_outer_face': bi, 'bore_face': boi,
+            'set_screw_face': si, 'keyway_floor_box': ki,
+            'flange_top_z_mm': face_info(flange_top[0])['box'][5],
+            'boss_top_z_mm': face_info(boss_top[0])['box'][5],
+            'bbox_mm': b, 'volume_mm3': volume(d), 'bodies': bodies(d),
+        }
+        (RUN / 'b1_dimensional_checks.json').write_text(json.dumps(result, indent=2), encoding='utf-8')
+        print(json.dumps(result, indent=2), flush=True)
+        close(j.sw, d)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/solidworks/playbook/eval/luna-b/b2_bracket.py b/tools/solidworks/playbook/eval/luna-b/b2_bracket.py
new file mode 100644
index 0000000000000000000000000000000000000000..6b1bd32096935538270cb0594f968b1a14dac336
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-b/b2_bracket.py
@@ -0,0 +1,217 @@
+"""B2: model, inspect, and evaluate the wall bracket with three mesh sizes and a support sensitivity case."""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+SIM = ROOT / 'cad' / '_sim' / 'sw-eval' / 'luna-b'
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swkit import MID, Sk, bbox, bodies, expect, export, extrude, feature_errors, face_info, job, new_part, pick, plane, save, single_body, volume, edges_where, fillet  # noqa: E402
+from swfea import PETG, converge, static  # noqa: E402
+
+
+SIZES = (4.0, 3.5, 3.0)
+ALLOW = {'vm': 45.0, 'layer': 22.5, 'shear': 13.0}
+
+
+def expected_faces(d):
+    holes = pick(d, kind='cyl', r=2.25)
+    load = pick(d, kind='plane', normal=(0, 0, 1), at=(60, 20, 52), area=100)
+    backing = pick(d, kind='plane', normal=(-1, 0, 0), at=(0, 20, 30))
+    expect('two screw-hole walls', len(holes), 2, 0)
+    expect('dedicated last-10-mm load face', len(load), 1, 0)
+    expect('load face area mm2', face_info(load[0])['area'], 100, 0.05)
+    expect('wall back face', len(backing), 1, 0)
+    return holes, load, backing
+
+
+def make_model(j):
+    path = CAD / 'wall_bracket.SLDPRT'
+    d = new_part(j.sw, path)
+
+    with Sk(d, plane(d, 'X', 2.5, 'WALL_P'), 'WALL') as s:
+        s.rect((2.5, 0, 0), (2.5, 40, 60))
+    extrude(d, s.feat, 'WALL', 5.0, mode=MID, expect_dv=5 * 40 * 60)
+    save(d)
+
+    with Sk(d, plane(d, 'X', 35.0, 'ARM_P'), 'ARM') as s:
+        s.rect((35, 15, 40), (35, 25, 52))
+    extrude(d, s.feat, 'ARM', 60.0, mode=MID, expect_dv=60 * 10 * 12)
+    save(d)
+
+    root = edges_where(d, lambda p: abs(p[0] - 5.0) < 0.02 and min(abs(p[2] - 40.0), abs(p[2] - 52.0)) < 0.02
+                       and 14.9 <= p[1] <= 25.1)
+    expect('root edges along Y', len(root), 2, 0)
+    radius = fillet(d, root, (3.0,), 'ROOT_FILLET')
+    if radius is None:
+        raise RuntimeError('R3 root fillet did not build')
+    expect('root fillet radius', radius, 3.0, 0)
+    save(d)
+
+    # A 0.1 mm step gives the specified last-10-mm top load patch its own planar face (05-fea.md).
+    v0 = volume(d)
+    with Sk(d, plane(d, 'Z', 51.95, 'LOAD_STEP_P'), 'LOAD_STEP') as s:
+        s.rect((10.0, 14.0, 51.95), (55.0, 26.0, 51.95))
+    extrude(d, s.feat, 'LOAD_STEP', 0.1, cut=True, mode=MID)
+    dv = v0 - volume(d)
+    expect('load-face step removed volume mm3', dv, 45.0, 0.01)
+    save(d)
+
+    with Sk(d, plane(d, 'X', 2.5, 'SCREW_P'), 'SCREWS') as s:
+        s.circle((2.5, 20.0, 12.0), 2.25)
+        s.circle((2.5, 20.0, 48.0), 2.25)
+    # Exactly the 5 mm wall-plate thickness. The upper hole meets the arm at X=5; see REPORT.md.
+    extrude(d, s.feat, 'SCREW_HOLES', 5.0, cut=True, mode=MID, expect_dv=2 * math.pi * 2.25 ** 2 * 5)
+    save(d)
+
+    if feature_errors(d):
+        raise RuntimeError(f'feature errors: {feature_errors(d)}')
+    single_body(d)
+    expect('one bracket body', len(bodies(d)), 1, 0)
+    b = bbox(d)
+    for k, want in enumerate((0, 0, 0, 65, 40, 60)):
+        expect(f'bracket box[{k}] mm', b[k], want, 0.02)
+    hand_volume = (5 * 40 * 60 + 60 * 10 * 12 - 2 * 3 ** 2 * (1 - math.pi / 4) * 10
+                   - 45 - 2 * math.pi * 2.25 ** 2 * 5)
+    expect('bracket volume mm3', volume(d), hand_volume, 0.01)
+
+    # Measure the hole centres from the finished cylindrical faces.
+    holes = pick(d, kind='cyl', r=2.25)
+    expect('screw-hole cylindrical faces after fillet and step', len(holes), 2, 0)
+    centers = sorted(tuple(round((face_info(f)['box'][i] + face_info(f)['box'][i + 3]) / 2, 2) for i in (1, 2))
+                     for f in holes)
+    if centers != [(20.0, 12.0), (20.0, 48.0)]:
+        raise RuntimeError(f'finished screw-hole centres are {centers}')
+    expect_faces(d)
+    save(d)
+    export(j.sw, d, CAD / 'wall_bracket.stl')
+    return d
+
+
+def save_result(r, key):
+    SIM.mkdir(parents=True, exist_ok=True)
+    np.savez_compressed(SIM / f'{key}.npz', pos=r.pos, stress=r.s, displacement=r.disp,
+                        fixed_points=r.fixed_pts, loaded_points=r.loaded_pts)
+
+
+def evaluate(j, d):
+    j.simulation()
+    # Re-open after Simulation is loaded, then rebuild before any geometry picks.
+    from swkit import close, open_doc  # local to make the required order visible
+    close(j.sw, d)
+    d = open_doc(j.sw, CAD / 'wall_bracket.SLDPRT')
+    d.ForceRebuild3(False)
+    volume_mm3 = volume(d)
+    results = []
+    expected_hand = 60 * 55 * 6 / (10 * 12 ** 3 / 12)
+    print(f'PREDICTION hand root stress={expected_hand:.3f} MPa; beam deflection ~1.27 mm; peak near root fillet; '
+          f'nodes by plain-part estimate at {SIZES}: '
+          + ', '.join(str(round(12 * volume_mm3 / el ** 3)) for el in SIZES), flush=True)
+
+    def runner(el):
+        holes, load, _ = expected_faces(d)
+        # Add local control at the small loading patch and the two cylindrical screw walls.
+        estimate = round(12 * volume_mm3 / el ** 3)
+        print(f'PREDICT B2 el={el:.2f} mm nodes={estimate}; peak near root fillet, displacement about 1.27 mm', flush=True)
+        r = static(j, d, f'B2_fixed_{el:.2f}', PETG, fixtures=[('fixed', holes)], loads=[('normal', load, 60.0)],
+                   el=el, ctrl=[(load, 1.0), (holes, 1.0)], max_nodes=199999)
+        save_result(r, f'B2_fixed_{el:.2f}')
+        results.append(r)
+        return r
+
+    # Y is the hand-predicted best layer normal: bending stress lies in the print plane and the dominant XZ beam shear
+    # also lies in the layer plane. All three axes are calculated from each same solve below.
+    rows, converged_y = converge(runner, SIZES, tol=0.05, layers=(0, 1, 0))
+    r = results[-1]
+    stable_dist = 2 * max(SIZES)
+    orientations = {}
+    for label, n in (('X', (1, 0, 0)), ('Y', (0, 1, 0)), ('Z', (0, 0, 1))):
+        keep = r.away(dist=stable_dist)
+        vm, at = r.peak(keep)
+        layer, layer_at = r.layer_stress(n, keep)
+        shear, shear_at = r.layer_shear(n, keep)
+        orientations[label] = {'peak_vm_mpa': vm, 'peak_vm_at_mm': at, 'layer_stress_mpa': layer,
+                               'layer_stress_at_mm': layer_at, 'layer_shear_mpa': shear,
+                               'layer_shear_at_mm': shear_at, 'sf_vm': ALLOW['vm'] / vm,
+                               'sf_layer': ALLOW['layer'] / layer if layer > 0 else None,
+                               'sf_shear': ALLOW['shear'] / shear if shear > 0 else None}
+    best = max(orientations, key=lambda axis: min(orientations[axis]['sf_vm'], orientations[axis]['sf_layer'],
+                                                    orientations[axis]['sf_shear']))
+    o = orientations[best]
+    root_roi = r.in_box([5.0, 14.0, 38.0, 18.0, 26.0, 54.0]) & r.away(dist=2.0)
+    root_peak, root_at = r.peak(root_roi)
+    raw_peak = float(r.vm.max())
+
+    # A second support idealization gives a bound on fixture sensitivity (whole wall face fixed); it is not the physical
+    # screw boundary condition. Keep the same coarse mesh and loads.
+    holes, load, backing = expected_faces(d)
+    alt = static(j, d, 'B2_backface_support', PETG, fixtures=[('fixed', backing)], loads=[('normal', load, 60.0)],
+                 el=SIZES[0], ctrl=[(load, 1.0)], max_nodes=199999)
+    save_result(alt, 'B2_backface_support')
+    alt_vm, alt_at = alt.peak(alt.away(dist=2 * SIZES[0]))
+
+    # Plain section readback at mid-arm, about 25 mm from the load centroid, one full section from the root.
+    section = r.in_box([34.5, 18.5, 51.5, 35.5, 21.5, 52.01])
+    sec_vm = float(r.vm[section].mean()) if section.any() else None
+    per_axis = {}
+    for label, n in (('X', (1, 0, 0)), ('Y', (0, 1, 0)), ('Z', (0, 0, 1))):
+        series = []
+        for item in results:
+            keep = item.away(dist=stable_dist)
+            series.append([item.peak(keep)[0], item.layer_stress(n, keep)[0], item.layer_shear(n, keep)[0]])
+        last = np.array(series[-1], dtype=float)
+        prev = np.array(series[-2], dtype=float)
+        ok = bool(np.all(np.abs(last - prev) <= 0.05 * np.maximum(np.abs(last), 1e-9)))
+        per_axis[label] = {'series_vm_layer_shear': series, 'converged_all_three': ok}
+    converged = per_axis[best]['converged_all_three']
+    reaction = r.reaction[3] if r.reaction else None
+    max_disp = r.max_disp()
+    pass_all = (converged and reaction is not None and abs(reaction - 60) <= 0.6 and max_disp is not None
+                and o['sf_vm'] >= 2 and o['sf_layer'] >= 2 and o['sf_shear'] >= 2)
+    verdict = 'pass' if pass_all else ('fail' if o['sf_vm'] < 2 or o['sf_layer'] < 2 or o['sf_shear'] < 2 else 'not shown')
+    ans = {
+        'hand_root_stress_mpa': expected_hand,
+        'hand_tip_deflection_mm': 60 * 55 ** 3 / (3 * PETG['EX'] / 1e6 * (10 * 12 ** 3 / 12)),
+        'print_orientation': f'layers stacked along {best}',
+        'nodes': r.nodes,
+        'mesh_series': rows,
+        'orientation_table': orientations,
+        'convergence_by_orientation': per_axis,
+        'peak_vm_mpa': o['peak_vm_mpa'],
+        'peak_vm_at_mm': o['peak_vm_at_mm'],
+        'root_roi_vm_mpa': root_peak,
+        'root_roi_at_mm': root_at,
+        'raw_vm_including_exclusions_mpa': raw_peak,
+        'layer_stress_mpa': o['layer_stress_mpa'],
+        'layer_shear_mpa': o['layer_shear_mpa'],
+        'sf_yield': o['sf_vm'],
+        'sf_layer': o['sf_layer'],
+        'sf_shear': o['sf_shear'],
+        'max_disp_mm': max_disp,
+        'reaction_n': reaction,
+        'converged': converged,
+        'converged_y_from_helper': converged_y,
+        'plain_section_mean_vm_mpa': sec_vm,
+        'support_sensitivity': {'wall_face_fixed_coarse_vm_mpa': alt_vm, 'at_mm': alt_at, 'nodes': alt.nodes},
+        'status': 'complete',
+        'verdict': verdict,
+        'notes': 'Peak excludes nodes within 8 mm of fixture and load for mesh-series comparability; see REPORT.md for the root ROI and support sensitivity.'
+    }
+    (RUN / 'b2_result.json').write_text(json.dumps(ans, indent=2), encoding='utf-8')
+    print(json.dumps(ans, indent=2), flush=True)
+    return ans
+
+
+def main():
+    with job(wait_s=1800) as j:
+        d = make_model(j)
+        evaluate(j, d)
+
+
+if __name__ == '__main__':
+    main()
