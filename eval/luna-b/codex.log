How to use it, and why each helper is shaped the way it is: playbook/README.md. Everything here takes and returns
millimetres and degrees in the model frame; SolidWorks itself works in metres and radians, and the helpers convert.

The feature calls are the ones the left-arm build scripts proved on SolidWorks 2026 (cad/scripts/arm/swg.py and
organic_master.py on branch left-arm-organic-r1). Windows only: needs pywin32, psutil and numpy.
"""
import math
import os
import sys
import time
from pathlib import Path

import numpy as np
import psutil
import pythoncom
from win32com.client import VARIANT

sys.path.insert(0, str(Path(__file__).resolve().parent))
from sw_instance import launch  # noqa: E402

m = 1e-3
NUL = VARIANT(pythoncom.VT_DISPATCH, None)       # "no object" for an optional COM argument; plain None is refused
BASE = {'X': 'Right Plane', 'Y': 'Top Plane', 'Z': 'Front Plane'}       # the default plane normal to each model axis
BLIND, THRU_ALL, UP_TO_NEXT, MID = 0, 1, 2, 6      # swEndConditions_e
PART, ASSEMBLY = 1, 2                              # swDocumentTypes_e
MIN_FREE_GB = 8.0                                  # holly-pc rule: leave this much free after a launch (cad-workstation.md)


class Failed(RuntimeError):
    """A SolidWorks step did not do what was asked. The message names the step; nothing after it has run."""


def L(v=0):
    """A by-reference long, for the error and warning out-arguments: e = L(); f(..., e); e.value."""
    return VARIANT(pythoncom.VT_BYREF | pythoncom.VT_I4, v)


def call(o, name, *a):
    """Read o.name whether late binding exposes it as a property or as a method (it differs between calls and builds)."""
    v = getattr(o, name)
    if hasattr(v, '_oleobj_'):       # a COM object is callable too: it is the value, not a method (measured on
        return v                     # GetFirstDisplayDimension, 2026-11-13)
    return v(*a) if callable(v) else v


def dispatch_array(items):
    """A COM array of objects (faces, edges), for the calls that refuse a Python list (CreateContactSet)."""
    return VARIANT(pythoncom.VT_ARRAY | pythoncom.VT_DISPATCH, list(items))


def log(*a):
    print(time.strftime('%H:%M:%S'), *a, flush=True)


def free_gb():
    return psutil.virtual_memory().available / 2 ** 30


class job:
    """with job() as j: one SolidWorks instance for one script, closed on the way out whatever happens.

    Refuses to start when the machine has less than min_free_gb free. j.sw is the SldWorks object, j.inst the
    sw_instance.Instance (j.inst.pid for claims.py), j.simulation() loads the Simulation add-in.
    """

    def __init__(self, min_free_gb=MIN_FREE_GB, visible=False, wait_s=0):
        self.min_free_gb, self.visible, self.wait_s = min_free_gb, visible, wait_s
        self.inst = self.sw = None

    def __enter__(self):
        if free_gb() < self.min_free_gb:
            raise Failed(f'only {free_gb():.1f} GB free, under the {self.min_free_gb} GB floor: wait, do not launch')
        end = time.time() + self.wait_s
        while True:
            try:
                self.inst = launch(visible=self.visible)
                break
            except RuntimeError as ex:
                # another instance is solving and cannot answer: that is a queue, not a fault. With wait_s the job
                # keeps asking until the time is up; without it the first refusal is raised as before.
                if 'did not answer' not in str(ex) or time.time() >= end:
                    raise
                log('launch is waiting behind a busy instance:', str(ex)[:120])
                time.sleep(20)
        self.sw = self.inst.sw
        pin_export_prefs(self.sw)
        log('SolidWorks pid', self.inst.pid, 'free GB', round(free_gb(), 1))
        return self

    def simulation(self):
        return self.inst.load_simulation()

    def __exit__(self, *exc):
        log('closing pid', self.inst.pid, 'committed MB', self._private())
        self.inst.close()

    def _private(self):
        try:
            return self.inst.private_mb()
        except psutil.Error:
            return '?'


# ---- documents ---------------------------------------------------------------------------------------------------------

def pin_export_prefs(sw):
    """STL and STEP options are per-machine settings, not part of a part: set them so every machine exports alike.

    Binary STL in mm, quality Fine, kept in the model frame (no shift to positive space), STEP AP203 (cad.md section 9).
    """
    sw.SetUserPreferenceToggle(69, True)           # swSTLBinaryFormat
    sw.SetUserPreferenceToggle(71, True)           # swSTLDontTranslateToPositive
    sw.SetUserPreferenceIntegerValue(211, 0)       # swExportStlUnits = mm
    sw.SetUserPreferenceIntegerValue(78, 2)        # swSTLQuality = Fine
    sw.SetUserPreferenceIntegerValue(75, 203)      # swStepAP = AP203


def part_template(sw):
    """The part template: SolidWorks' default if one is set, else SW_PART_TEMPLATE, else the first installed .prtdot."""
    t = sw.GetUserPreferenceStringValue(8) or os.environ.get('SW_PART_TEMPLATE', '')      # 8 = swDefaultTemplatePart
    if t and os.path.exists(t):
        return t
    found = sorted(Path(r'C:\ProgramData\SOLIDWORKS').glob('SOLIDWORKS 20*/templates/**/*.prtdot'))
    if not found:
        raise Failed('no part template: set SW_PART_TEMPLATE to a .prtdot file')
    return str(found[-1])


def new_part(sw, path):
    """A new empty part in MMGS units, saved at path at once (an unsaved document is lost with the instance)."""
    sw.CloseAllDocuments(True)       # a failed earlier build leaves its part open, and NewDocument then throws
    d = sw.NewDocument(part_template(sw), 0, 0, 0)
    if d is None:
        raise Failed('NewDocument returned nothing')
    d.Extension.SetUserPreferenceInteger(263, 0, 5)      # swUnitSystem = MMGS, whatever the template says
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    save_as(d, path)
    return d


def open_doc(sw, path, kind=PART):
    """Open a part (or assembly) silently and make it the active document."""
    e, w = L(), L()
    d = sw.OpenDoc6(str(path), kind, 1, '', e, w)        # 1 = swOpenDocOptions_Silent
    if d is None:
        raise Failed(f'open failed: {path} errors {e.value} warnings {w.value}')
    sw.ActivateDoc3(d.GetTitle, False, 0, L())
    return d


def save(d):
    """Rebuild and save in place. Call it after every step that worked (RULES.md rule 5)."""
    d.ForceRebuild3(False)
    e, w = L(), L()
    if not d.Save3(1, e, w):                             # 1 = swSaveAsOptions_Silent
        raise Failed(f'save failed: {d.GetPathName} errors {e.value} warnings {w.value}')


def save_as(d, path):
    e, w = L(), L()
    ok = d.Extension.SaveAs(str(path), 0, 1, NUL, e, w)
    if not ok or not os.path.exists(path) or os.path.getsize(path) == 0:
        raise Failed(f'save as failed: {path} errors {e.value} warnings {w.value}')


def export(sw, d, path):
    """Export the part to .step or .stl by its extension, with the pinned options, and check the file landed."""
    pin_export_prefs(sw)
    d.ForceRebuild3(False)
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    if os.path.exists(path):
        os.remove(path)
    save_as(d, path)
    log('exported', path, os.path.getsize(path), 'bytes')


def close(sw, d):
    sw.CloseDoc(d.GetTitle)


def import_step(sw, step, target):
    """Import a STEP file and save it as a native part or assembly at target (extension chosen by what came in)."""
    data = sw.GetImportFileData(str(step))
    e = L()
    d = sw.LoadFile4(str(step), 'r', data, e)
    if d is None:
        raise Failed(f'import failed: {step} error {e.value}')
    target = Path(target).with_suffix('.SLDASM' if d.GetType == ASSEMBLY else '.SLDPRT')
    save_as(d, target)
    return d, target


# ---- measuring: the check after every feature --------------------------------------------------------------------------

def solid_bodies(d):
    return list(d.GetBodies2(0, True) or [])             # 0 = swSolidBody, visible only


def volume(d):
    """Total solid volume in mm3."""
    return sum(b.GetMassProperties(1000.0)[3] for b in solid_bodies(d)) * 1e9


def bodies(d):
    """[(name, volume mm3, [x0, y0, z0, x1, y1, z1] mm)] for every solid body."""
    return [(b.Name, round(b.GetMassProperties(1000.0)[3] * 1e9, 2), [round(v * 1e3, 3) for v in b.GetBodyBox()])
            for b in solid_bodies(d)]


def bbox(d):
    """[x0, y0, z0, x1, y1, z1] in mm over all solid bodies."""
    bs = np.array([b[2] for b in bodies(d)])
    return [float(v) for v in bs[:, :3].min(axis=0)] + [float(v) for v in bs[:, 3:].max(axis=0)]


def expect(what, got, want, tol):
    """The plane normal to model axis 'X', 'Y' or 'Z' at that coordinate (mm). Offset 0 returns the base plane."""
    base = d.FeatureByName(BASE[axis])
    if base is None:
        raise Failed(f'no "{BASE[axis]}" in this part (a template in another language renames the base planes)')
    if abs(off) < 1e-9:
        return base
    d.ClearSelection2(True)
    base.Select2(False, 0)
    p = d.FeatureManager.InsertRefPlane(8 + (256 if off < 0 else 0), abs(off) * m, 0, 0, 0, 0)      # 8 distance, 256 flip
    if p is None:
        raise Failed('plane failed: ' + name)
    p.Name = name
    return p


class Sk:
    """with Sk(d, plane, name) as s: draw with 3D model points in mm; they are mapped into the sketch for you.

    The points go through the sketch's own ModelToSketchTransform, so it never matters which way a plane's sketch axes
    point or whether the plane was flipped. A point that does not lie on the sketch plane raises: that is the plane at
    the wrong offset, caught before it becomes a feature in the wrong place. s.feat is the finished sketch.
    """

    def __init__(self, d, pl, name):
        self.d, self.pl, self.name = d, pl, name

    def __enter__(self):
        d = self.d
        d.ClearSelection2(True)
        self.pl.Select2(False, 0)
        d.SketchManager.InsertSketch(True)
        sk = d.GetActiveSketch2
        if sk is None:
            raise Failed('sketch did not open: ' + self.name)
        self.T = sk.ModelToSketchTransform.ArrayData
        d.SketchManager.AddToDB = True       # straight to the database: no snapping or inferred relations to move points
        return self

    def p(self, q):
        T = self.T
        x, y, z = q[0] * m, q[1] * m, q[2] * m
        w = x * T[2] + y * T[5] + z * T[8] + T[11]
        if abs(w) > 1e-6:
            raise Failed(f'{self.name}: point {tuple(q)} is {abs(w) / m:.4f} mm off the sketch plane')
        return x * T[0] + y * T[3] + z * T[6] + T[9], x * T[1] + y * T[4] + z * T[7] + T[10]

    def poly(self, pts, closed=True):
        P = [self.p(q) for q in pts]
        for a, b in zip(P, (P[1:] + P[:1]) if closed else P[1:]):
            if self.d.SketchManager.CreateLine(a[0], a[1], 0, b[0], b[1], 0) is None:
                raise Failed(f'{self.name}: line not drawn (two points closer than 1e-5 mm?)')

    def rect(self, a, b):
        """Axis-aligned rectangle between opposite corners a and b, which must lie on the sketch plane."""
        k = [i for i in range(3) if abs(a[i] - b[i]) > 1e-9]
        if len(k) != 2:
            raise Failed(f'{self.name}: rect corners must differ in exactly two coordinates')
        c, e = list(a), list(a)
        c[k[0]], e[k[1]] = b[k[0]], b[k[1]]
        self.poly([a, c, b, e])

    def circle(self, c, r):
        a = self.p(c)
        if self.d.SketchManager.CreateCircleByRadius(a[0], a[1], 0, r * m) is None:
            raise Failed(f'{self.name}: circle not drawn')

    def arc(self, c, p0, p1, direction):
        """Arc about centre c from p0 to p1. direction +1 is counter-clockwise seen in the sketch's own axes, which may be
        mirrored against the model's: give the feature its expect_dv, and flip the sign if the volume is wrong."""
        a, b, e = self.p(c), self.p(p0), self.p(p1)
        self.d.SketchManager.CreateArc(a[0], a[1], 0, b[0], b[1], 0, e[0], e[1], 0, direction)

    def spline(self, pts, closed=True):
        arr = []
        for q in list(pts) + (list(pts[:1]) if closed else []):
            u, v = self.p(q)
            arr += [u, v, 0.0]
        if self.d.SketchManager.CreateSpline2(VARIANT(pythoncom.VT_ARRAY | pythoncom.VT_R8, arr), True) is None:
            raise Failed(f'{self.name}: spline not drawn')

    def centerline(self, a, b):
        """The axis for a revolve."""
        p, q = self.p(a), self.p(b)
        self.d.SketchManager.CreateCenterLine(p[0], p[1], 0, q[0], q[1], 0)

    def __exit__(self, et, ev, tb):
        self.d.SketchManager.AddToDB = False
        self.d.InsertSketch2(True)
        if et is None:
            self.feat = self.d.FeatureByPositionReverse(0)
            self.feat.Name = self.name + '_SK'


# ---- features ----------------------------------------------------------------------------------------------------------

def extrude(d, sk, name, depth, cut=False, mode=BLIND, want=None, min_dv=1.0, expect_dv=None):
    """Extrude a sketch (cut=True removes material) and check what it did.

    mode MID extrudes depth in total, half each side of the sketch plane: nothing to get backwards, so put the sketch
    plane at the middle of the feature whenever you can. BLIND goes depth one way; THRU_ALL cuts one way, and both ways are tried until the volume moves the right way.
    For BLIND and UP_TO_NEXT both directions are tried, and want = (axis index 0/1/2, sign, plane coordinate mm) keeps
    the one whose new faces lie on that side of the sketch plane.
    Raises unless the volume changed by more than min_dv mm3 the right way, and, when expect_dv is given, by that
    amount within 1 %.
    """
    fm = d.FeatureManager
    dep = abs(depth) * m
    for rev in ((False,) if mode == MID else (False, True)):
        v0 = volume(d)
        d.ClearSelection2(True)
        sk.Select2(False, 0)
        if cut:
            f = fm.FeatureCut4(True, False, rev, mode, 0, dep, dep, False, False, False, False, 0, 0, False, False, False,
                               False, False, False, True, False, False, False, 0, 0, False, False)
        else:
            f = fm.FeatureExtrusion3(True, False, rev, mode, 0, dep, dep, False, False, False, False, 0, 0, False, False,
                                     False, False, True, False, True, 0, 0, False)
            if f is None:      # auto-select merge fails on some multi-body states; feature scope without it works
                d.ClearSelection2(True)
                sk.Select2(False, 0)
                f = fm.FeatureExtrusion3(True, False, rev, mode, 0, dep, dep, False, False, False, False, 0, 0, False,
                                         False, False, False, True, True, False, 0, 0, False)
        if f is None:
            continue
        d.ForceRebuild3(False)
        dv = (v0 - volume(d)) if cut else (volume(d) - v0)
        ok = dv > min_dv
        if ok and want is not None:
            ax, sign, c0 = want
            vals = []
            for fc in (call(f, 'GetFaces') or []):
                b = call(fc, 'GetBox')
                vals += [b[ax] * 1e3, b[ax + 3] * 1e3]
            ok = bool(vals) and (sum(vals) / len(vals) - c0) * sign > 0
        if ok:
            if expect_dv is not None:
                expect(name + ' volume change', dv, expect_dv, 0.01)
            f.Name = name
            log(f'{name}: {"cut" if cut else "added"} {dv:.2f} mm3')
            return f
        d.EditUndo2(1)
    raise Failed(f'{name}: no {"cut" if cut else "extrude"} changed the volume the right way '
                 '(open sketch? sketch off the body? wrong side?)')


def revolve(d, sk, name, cut=False, angle=360.0, mid=False, min_dv=1.0, expect_dv=None):
    """Revolve a closed profile about the centreline drawn in the same sketch (Sk.centerline)."""
    v0 = volume(d)
    d.ClearSelection2(True)
    sk.Select2(False, 0)
    f = d.FeatureManager.FeatureRevolve2(True, True, False, cut, False, False, 6 if mid else 0, 0, math.radians(angle),
                                         0, False, False, 0, 0, 0, 0, 0, True, False, True)
    d.ForceRebuild3(False)
    dv = (v0 - volume(d)) if cut else (volume(d) - v0)
    if f is None or dv < min_dv:
        raise Failed(f'{name}: revolve failed (profile open, or crossing its centreline?)')
    if expect_dv is not None:
        expect(name + ' volume change', dv, expect_dv, 0.01)
    f.Name = name
    log(f'{name}: {"cut" if cut else "added"} {dv:.2f} mm3')
    return f


def loft(d, sketches, name):
    """Loft through closed section sketches, in order. Tries with and without merging into the existing body."""
    v0 = volume(d)
    for merge in (True, False):
        d.ClearSelection2(True)
        for k in sketches:
            k.Select2(True, 1)
        f = d.FeatureManager.InsertProtrusionBlend2(False, True, False, 1.0, 0, 0, 1.0, 1.0, True, True, False, 0, 0, 0,
                                                    True, merge, merge, 0)
        if f is not None:
            d.ForceRebuild3(False)
            f.Name = name
            log(f'{name}: added {volume(d) - v0:.2f} mm3 (merge {merge})')
            return f
    raise Failed(name + ': loft failed (sections must be closed, and their start points roughly in line)')


def shell(d, open_face_points, t, name):
    """Shell to wall thickness t mm, removing the faces at the given 3D points (each must lie on exactly one face).

    The faces are found by geometry and selected as objects: SelectByID2 by coordinates found nothing on a hidden
    instance (2026-11-12). With no points the part is hollowed with no opening.
    """
    hit = [pick(d, at=p) for p in open_face_points]
    if any(len(h) != 1 for h in hit):
        raise Failed(f'{name}: each point must lie on exactly one face; faces found {[len(h) for h in hit]} at '
                     f'{list(open_face_points)} (a point on an edge lies on two)')
    d.ClearSelection2(True)
    for h in hit:
        if not h[0].Select4(True, NUL):
            raise Failed(f'{name}: face not selected')
    v0 = volume(d)
    d.InsertFeatureShell(t * m, False)
    d.ForceRebuild3(False)
    f = d.FeatureByPositionReverse(0)
    if f is None or f.GetTypeName2 != 'Shell' or v0 - volume(d) < 1.0:
        raise Failed(f'{name}: shell failed (wall thicker than a local radius or a thin region?)')
    f.Name = name
    log(f'{name}: {t} mm wall, volume {volume(d):.1f} mm3')
    return f


def edges_where(d, test):
    """Edges whose start, middle and end points (mm) all pass test(p). Select by where an edge IS, never by its name."""
    out = []
    for b in solid_bodies(d):
        for e in (call(b, 'GetEdges') or []):
            cp = e.GetCurveParams3
            mid = e.GetCurve.Evaluate2((cp.UMinValue + cp.UMaxValue) / 2, 0)
            pts = [np.array(cp.StartPoint[:3]) * 1e3, np.array(list(mid)[:3]) * 1e3, np.array(cp.EndPoint[:3]) * 1e3]
            if all(test(p) for p in pts):
                out.append(e)
    return out


def fillet(d, edges, radii, name):
    """Round the edges with the first radius in radii (mm) that builds; returns that radius, or None if none did.

    Edge objects go stale once any feature is added: find them (edges_where) straight before this call.
    """
    if not edges:
        raise Failed(name + ': no edges to round (the edge test matched nothing)')
    for r in radii:
        v0 = volume(d)
        d.ClearSelection2(True)
        for e in edges:
            e.Select4(True, NUL)
        f = d.FeatureManager.FeatureFillet3(3, r * m, 0, 0, 0, 0, 0, NUL, NUL, NUL, NUL, NUL, NUL, NUL)
        if f is not None:
            d.ForceRebuild3(False)
            f.Name = name
            log(f'{name}: R{r} on {len(edges)} edges, volume change {volume(d) - v0:+.2f} mm3')
            return r
    log(f'{name}: no round built on {len(edges)} edges at {tuple(radii)}')
    return None


def chamfer(d, edges, width, name, angle=45.0):
    if not edges:
        raise Failed(name + ': no edges to chamfer')
    d.ClearSelection2(True)
    for e in edges:
        e.Select4(True, NUL)
    f = d.FeatureManager.InsertFeatureChamfer(0, 1, width * m, math.radians(angle), 0, 0, 0, 0)
    d.ForceRebuild3(False)
    if f is None:
        raise Failed(name + ': chamfer failed')
    f.Name = name
    return f


def cut_half_space(d, axis, at, keep_sign, name, span=400.0, min_dv=1.0):
    """Remove everything on the far side of the plane axis = at; keep_sign +1 keeps the side with larger coordinates.

    min_dv: the smallest volume in mm3 the cut must remove (lower it to trim a sliver)."""
    c = at - keep_sign * span / 2
    i = 'XYZ'.index(axis)
    a, b = [-span] * 3, [span] * 3
    a[i] = b[i] = c
    with Sk(d, plane(d, axis, c, name + '_P'), name) as s:
        s.rect(a, b)
    return extrude(d, s.feat, name, span, cut=True, mode=MID, min_dv=min_dv)


def insert_body(d, part_path):
    """Bring another part's solid in as an extra body, at the same coordinates (multi-body models for contact FEA).

    The body stays separate even where it overlaps one already there (measured 2026-11-12), so nothing here tells you
    about an overlap: check for it yourself. The part must hold exactly one solid body.
    """
    n0 = len(solid_bodies(d))
    f = d.InsertPart3(str(part_path), 1, '')       # 1 = swInsertPartImportSolids
    d.ForceRebuild3(False)
    if f is None or len(solid_bodies(d)) != n0 + 1:
        raise Failed(f'{part_path} did not come in as its own body (bodies {bodies(d)})')
    return f


def delete_body(d, name):
    d.ClearSelection2(True)
    if not d.Extension.SelectByID2(name, 'SOLIDBODY', 0, 0, 0, False, 0, NUL, 0):
        raise Failed('no body ' + name)
    f = d.FeatureManager.InsertDeleteBody2(False)
    d.ForceRebuild3(False)
    return f


def single_body(d, crumb_mm3=0.2):
    """Delete crumbs under crumb_mm3 and stop unless exactly one solid body is left: the state every print part must be in."""
    for b in bodies(d):
        if b[1] < crumb_mm3:
            delete_body(d, b[0])
    if len(bodies(d)) != 1:
        raise Failed(f'expected one body, got {bodies(d)}')


# ---- faces: pick by geometry -------------------------------------------------------------------------------------------

def faces(d):
    return [f for b in solid_bodies(d) for f in (call(b, 'GetFaces') or [])]


def face_info(f):
    """dict(kind 'cyl' | 'plane' | 'other', r mm or None, normal or None, box [lo xyz, hi xyz] mm, area mm2)."""
    s = f.GetSurface
    x = [v * 1e3 for v in call(f, 'GetBox')]
    box = [min(x[i], x[i + 3]) for i in range(3)] + [max(x[i], x[i + 3]) for i in range(3)]
    kind, r, n = 'other', None, None
    if s.IsCylinder:
        kind, r = 'cyl', s.CylinderParams[6] * 1e3
    elif s.IsPlane:
        kind, n = 'plane', [round(v, 4) for v in f.Normal]
    return dict(kind=kind, r=r, normal=n, box=box, area=call(f, 'GetArea') * 1e6)


def pick(d, kind=None, r=None, inside=None, normal=None, at=None, area=None, tol=0.02):
    """Faces matching every given filter. Stop and print list_faces(d) if a pick returns the wrong count.

    kind 'cyl' or 'plane'; r: cylinder radius mm (within tol); inside: [x0, y0, z0, x1, y1, z1] the face's box must lie
    within; normal: (nx, ny, nz) of a planar face (within 0.01); at: a point (mm) that must lie on the face (0.05 mm);
    area: mm2, within 5 %.
    """
    out = []
    for f in faces(d):
        i = face_info(f)
        if kind and i['kind'] != kind:
            continue
        if r is not None and (i['r'] is None or abs(i['r'] - r) > tol):
            continue
        if inside is not None and not all(i['box'][k] >= inside[k] - tol and i['box'][k + 3] <= inside[k + 3] + tol for k in range(3)):
            continue
        if normal is not None and (i['normal'] is None or max(abs(a - b) for a, b in zip(i['normal'], normal)) > 0.01):
            continue
        if area is not None and abs(i['area'] - area) > 0.05 * area:
            continue
        if at is not None:
            q = f.GetClosestPointOn(at[0] * m, at[1] * m, at[2] * m)
            if q is None or math.dist([v * 1e3 for v in list(q)[:3]], at) > 0.05:
                continue
        out.append(f)
    return out


def list_faces(d, limit=200):
    """Print every face's kind, radius or normal, area and box: how to find out what a pick should ask for."""
    for k, f in enumerate(faces(d)[:limit]):
        i = face_info(f)
        print(k, i['kind'], 'r' if i['r'] is not None else 'n', round(i['r'], 3) if i['r'] is not None else i['normal'],
              'area', round(i['area'], 2), 'box', [round(v, 2) for v in i['box']], flush=True)
            return
        try:
            win32gui.EnumWindows(each, pids)
        except Exception:      # noqa: BLE001
            pass


class Result:
    """Nodal results of one solved study, in the model frame.

    pos (n, 3) mm. s (n, 12) MPa: node, sx sy sz, txy txz tyz, p1 p2 p3, von Mises, stress intensity (p1 - p3).
    disp (n, 5) mm: node, UX UY UZ, resultant. reaction [Fx, Fy, Fz, resultant] N: what the fixtures push back with,
    summed over every restrained node, so it is equal and opposite to the applied load. applied: the size of the
    applied load in N (the sum of the sizes when there are several loads: compare by hand when they are not parallel).
    excessive: True when the solver reported excessive displacements (only reachable with loose_ok=True).
    Columns and units measured on SolidWorks 2026 SP0, 2026-11-12 (selftest.py beam, rod, steps).
    """

    def __init__(self, name, el, pos, s, fixed_pts, loaded_pts, disp, reaction, nodes, elements, seconds, applied):
        self.name, self.el, self.pos, self.s = name, el, pos, s
        self.fixed_pts, self.loaded_pts = fixed_pts, loaded_pts
        self.disp, self.reaction = disp, reaction
        self.nodes, self.elements, self.seconds, self.applied = nodes, elements, seconds, applied
        self.vm = s[:, 10]

    def away(self, k=2.0, dist=None):
        """Mask of nodes at least dist mm (default k element sizes) from every fixture and load face.

        Stress on a restrained or loaded face is an artefact of the idealisation, and at a sharp restrained edge it grows
        without limit as the mesh shrinks. Report the peak away from them, and say that you did. Across a convergence
        series pass the same dist every time: a mask of k elements shrinks with the mesh and lets the edge back in.
        The mask also hides real features next to a load face (a screw hole beside a loaded bore): read those
        separately with in_box() and report them.
        """
        keep = np.ones(len(self.pos), bool)
        for pts in (self.fixed_pts, self.loaded_pts):
            if pts is not None and len(pts):
                keep &= cKDTree(pts).query(self.pos)[0] >= (k * self.el if dist is None else dist)
        return keep

    def peak(self, mask=None):
        """(von Mises MPa, [x, y, z] mm) of the worst node in mask (default: away from fixtures and loads)."""
        mask = self.away() if mask is None else mask
        if not mask.any():
            raise Failed(f'{self.name}: no nodes left in the mask')
        i = np.flatnonzero(mask)[np.argmax(self.vm[mask])]
        return float(self.vm[i]), self.pos[i].round(2).tolist()

    def layer_stress(self, normal, mask=None):
        """(MPa, where) of the largest tensile stress across print layers whose normal is the given direction."""
        n = np.array(normal, float)
        n /= np.linalg.norm(n)
        S = self.s
        sn = (n[0] ** 2 * S[:, 1] + n[1] ** 2 * S[:, 2] + n[2] ** 2 * S[:, 3]
              + 2 * (n[0] * n[1] * S[:, 4] + n[0] * n[2] * S[:, 5] + n[1] * n[2] * S[:, 6]))
        mask = self.away() if mask is None else mask
        i = np.flatnonzero(mask)[np.argmax(sn[mask])]
        return float(sn[i]), self.pos[i].round(2).tolist()

    def layer_shear(self, normal, mask=None):
        """(MPa, where) of the largest shear stress on the plane between print layers stacked along the given direction.

        Judge it against the interlayer shear allowable (13 MPa for printed PETG, 05-fea.md).
        """
        n = np.array(normal, float)
        n /= np.linalg.norm(n)
        S = self.s
        t = np.c_[S[:, 1] * n[0] + S[:, 4] * n[1] + S[:, 5] * n[2],       # traction on the layer plane
                  S[:, 4] * n[0] + S[:, 2] * n[1] + S[:, 6] * n[2],
                  S[:, 5] * n[0] + S[:, 6] * n[1] + S[:, 3] * n[2]]
        tau = np.linalg.norm(t - np.outer(t @ n, n), axis=1)
        mask = self.away() if mask is None else mask
        i = np.flatnonzero(mask)[np.argmax(tau[mask])]
        return float(tau[i]), self.pos[i].round(2).tolist()

    def in_box(self, box):
        return np.all((self.pos >= np.array(box[:3])) & (self.pos <= np.array(box[3:])), axis=1)

    def average(self, at, radius):
        """Mean von Mises over the nodes within radius mm of a point, and how many nodes that was.

        A peak that falls back to the surrounding level within about 1 mm, on a handful of nodes, is a corner effect;
        one that holds over 2 mm is the section. Report the average with its node count beside any peak that governs.
        """
        idx = cKDTree(self.pos).query_ball_point(at, radius)
        return float(self.vm[idx].mean()), len(idx)

    def near(self, pts, dist):
        """Mask of nodes within dist mm of any of the given points (n, 3). Use it with a face's nodes to read a surface
        only: on a part in bending average() takes in nodes below the surface and reads low (22 % on a 4 mm wall)."""
        return cKDTree(np.atleast_2d(pts)).query(self.pos)[0] <= dist

    def max_disp(self):
        """Largest resultant displacement in mm, or None if displacements could not be read."""
        return None if self.disp is None else float(np.abs(self.disp[:, 4]).max())

    def summary(self, yield_mpa=45.0, mask=None):
        """The numbers of one study. On a model of several bodies pass mask: without it the peak is taken over every
        body, so a steel screw or pin is judged against the plastic's yield. Split the nodes by geometry (in_box, a
        radius) and call summary once per printed body."""
        vm, at = self.peak(mask)
        out = dict(study=self.name, el_mm=self.el, nodes=self.nodes, elements=self.elements, solve_s=round(self.seconds),
                   peak_vm_all=round(float(self.vm.max()), 2), peak_vm_away=round(vm, 2), at=at,
                   sf_yield=round(yield_mpa / vm, 2) if vm > 0 else None, max_disp_mm=self.max_disp(),
                   reaction_N=self.reaction, applied_N=self.applied)
        if getattr(self, 'excessive', False):
            out['excessive_displacements'] = True
        return out


@contextlib.contextmanager
def heavy_solve_lock(owner, wait_s=3600):
    """Hold the machine-wide lock for one heavy solve (over HEAVY_NODES). One such solve at a time on holly-pc.

    The lock is a file created exclusively, holding `owner=<thread> pid=<pid> start=<time>` (write it in this form in
    your own scripts too). A lock whose PID is dead, or that names no PID and is three hours old, is stale and is replaced; a live one is waited for (the other solve takes 7 to 11 minutes), up to wait_s, then Failed.
    static() takes it by itself; meshing, builds and post-processing need none.
    """
    t0 = time.time()
    while True:
        try:
            fd = os.open(HEAVY_LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            break
        except FileExistsError:
            try:
                text = HEAVY_LOCK.read_text()
                m = re.search(r'pid\W{0,3}(\d+)', text, re.I)
                pid = int(m.group(1)) if m else None
                old = time.time() - HEAVY_LOCK.stat().st_mtime > 3 * 3600
            except Exception:      # noqa: BLE001  being written, or gone again: treat as held
                text, pid, old = '?', None, False
            if pid is None and old:            # no PID to test and three hours old: no solve takes that long
                pid = -1
            if pid is not None and (pid < 0 or not psutil.pid_exists(pid)):
                log(f'heavy solve lock is stale ({text.strip()}): replacing it')
                try:
                    HEAVY_LOCK.unlink()
                except OSError:
                    pass
                continue
            if time.time() - t0 > wait_s:
                raise Failed(f'heavy solve lock held for over {wait_s} s by {text.strip()}') from None
            log(f'waiting for the heavy solve lock: {text.strip()}')
            time.sleep(20)
    try:
        os.write(fd, f'owner={owner} pid={os.getpid()} start={time.strftime("%Y-%m-%dT%H:%M:%S")}\n'.encode())
        os.close(fd)
        yield
    finally:
        try:
            HEAVY_LOCK.unlink()
        except OSError:
            pass


def static(j, d, name, material, fixtures, loads, el, ctrl=(), contacts=(), materials=None, solver=None, keep_study=False,
           post=None, loose_ok=False, max_nodes=MAX_NODES):
    """Build, mesh and solve one linear static study on the open part d, and read the nodal results back.

    material: the dict for every body, unless materials = {part of a body's name: dict} picks some bodies out. A key
    matches a body when the body's Simulation name contains it, whatever the case; that name is "SolidBody 3(PAD)" for
    a body made in the part and "SolidBody 2(<pad>-<PAD>)" for one brought in from pad.SLDPRT. A key that matches no
    body, or a body matched by two keys, raises, and each body's material is logged.
    fixtures: [('fixed' | 'hinge', faces)]. loads: [('normal', faces, newtons)] presses on the faces along their own
    normals with that many newtons IN TOTAL, shared between the faces by area (one even pressure; positive pushes into
    the material). [('remote', faces, (x, y, z) mm, (Fx, Fy, Fz) N, (Mx, My, Mz) N.m)] applies a force and moment at a
    point in the model frame, carried to the faces rigidly.
    el: global element size mm. ctrl: [(faces, size mm)] local mesh controls.
    contacts: [(NO_PENETRATION | BONDED, faces_a, faces_b)] for multi-body parts; everything else touching is bonded.
    solver: None leaves Automatic; SOLVER_DIRECT sets direct sparse through a macro (needed for no-penetration contact).
    loose_ok: when the solver reports excessive displacements (a body free to move, or held only by something very
    soft) static() raises, unless loose_ok=True, which returns the result with Result.excessive set.
    post: post(study, results) is called after the solve and before the study is deleted, for anything static() does
    not read itself; what it returns is kept as Result.extra.
    Every face list must be non-empty: an empty pick is the commonest way to solve the wrong problem.
    """
    t0 = time.time()
    cw = j.simulation()
    doc = cw.ActiveDoc
    if doc is None:
        raise Failed('Simulation sees no active document: open_doc() the model before static()')
    sm = doc.StudyManager
    err = L()
    tag = re.sub(r'[^A-Za-z0-9_ -]', '_', name)[:24]     # a dot in a study name fails with error 2 (2026-11-13)
    st = sm.CreateNewStudy3(tag, 0, 0, err)            # 0 static, 0 solid mesh
    if st is None or err.value:
        raise Failed(f'study not created ({err.value}); a study of the same name already in the model?')
    comp = st.SolidManager.GetComponentAt(0, L())
    used = set()
    for k in range(comp.SolidBodyCount):
        b = comp.GetSolidBodyAt(k, L())
        bname = str(call(b, 'SolidBodyName'))
        hit = [key for key in (materials or {}) if key.lower() in bname.lower()]
        if len(hit) > 1:
            raise Failed(f'{name}: body "{bname}" matches more than one materials key: {hit}')
        used.update(hit)
        mat = materials[hit[0]] if hit else material
        _material(b, mat)
        if materials:
            log(f'{name}: body "{bname}" is {mat["name"]}')
    if materials and used != set(materials):
        raise Failed(f'{name}: materials keys {sorted(set(materials) - used)} match no body')
    lbc = st.LoadsAndRestraintsManager
    fixed, loaded, applied = [], [], 0.0
    for kind, fs in fixtures:
        if not fs:
            raise Failed(f'{name}: a {kind} fixture has no faces')
        err = L()
        lbc.AddRestraint({'fixed': 0, 'hinge': 4}[kind], list(fs), NUL, err)
        if err.value:
            raise Failed(f'{name}: {kind} fixture failed ({err.value})')
        fixed += list(fs)
    for ld in loads:
        fs = list(ld[1])
        if not fs:
            raise Failed(f'{name}: a {ld[0]} load has no faces')
        loaded += fs
        err = L()
        if ld[0] == 'normal':
            # AddForce3 puts the value on EACH face it is given (two faces at 100 N reacted 200 N, 2026-11-12), so each
            # face gets its own call with its share by area
            areas = [call(f, 'GetArea') for f in fs]
            for f, a in zip(fs, areas):
                err = L()
                lbc.AddForce3(1, 0, -1, 0, 0, 0, NUL, NUL, False, False, 0, 0, 0, float(ld[2]) * a / sum(areas), [1.0] * 6,
                              False, False, [f], NUL, False, err)
                if err.value:
                    raise Failed(f'{name}: normal load failed ({err.value})')
            applied += abs(float(ld[2]))
        elif ld[0] == 'remote':
            at, f, mo = ld[2], ld[3], ld[4]
            r = lbc.AddRemoteLoad(1, fs, 0, at[0], at[1], at[2], err)
            call(r, 'RemoteLoadBeginEdit')
            r.ConnectionType = 0                   # rigid
            r.ForceUnit = 0                        # N
            r.MomentUnit = 0                       # N.m
            r.SetForceOrTranslationValues2(any(f), f[0] != 0, float(f[0]), f[1] != 0, float(f[1]), f[2] != 0, float(f[2]))
            r.SetMomentOrRotationValues2(any(mo), mo[0] != 0, float(mo[0]), mo[1] != 0, float(mo[1]), mo[2] != 0, float(mo[2]))
            rc = call(r, 'RemoteLoadEndEdit')
            if rc:
                raise Failed(f'{name}: remote load not accepted ({rc})')
            applied += float(np.linalg.norm(f))
        else:
            raise Failed(f'unknown load kind {ld[0]}')
        if err.value:
            raise Failed(f'{name}: {ld[0]} load failed ({err.value})')
    cm = st.ContactManager
    for kind, fa, fb in contacts:
        if not fa or not fb:
            raise Failed(f'{name}: a contact set has an empty side ({len(fa)}, {len(fb)} faces)')
        err = L()
        cs = cm.CreateContactSet(kind, dispatch_array(fa), dispatch_array(fb), err)
        if cs is None or err.value:
            raise Failed(f'{name}: contact set failed ({err.value})')
    mesh = st.Mesh
    mesh.Quality = 1                               # high: second-order tetrahedra
    for fs, size in ctrl:
        if not fs:
            raise Failed(f'{name}: a mesh control has no faces')
        q = mesh.ApplyMeshControl(list(fs), L())
        q = q[0] if isinstance(q, tuple) else q
        call(q, 'MeshControlBeginEdit')
        q.Units = 0                                # mm
        q.ElementSize = size
        q.Ratio = 1.5
        call(q, 'MeshControlEndEdit')
    rc = st.CreateMesh(0, el, el * 0.05)           # sizes in mm
    nodes, elements = int(mesh.NodeCount), int(mesh.ElementCount)
    log(f'{name}: mesh rc {rc}, {nodes} nodes, {elements} elements, free {free_gb():.1f} GB')
    if rc or not nodes:
        raise Failed(f'{name}: mesh failed ({rc}): sliver faces, or an element size larger than a thin wall?')
    if nodes > max_nodes:      # checked before the solve: pass a smaller max_nodes to hold a job to a budget
        raise Failed(f'{name}: {nodes} nodes is over {max_nodes}: coarsen the global size and keep the local controls')
    if solver is not None:
        log(f'{name}: solver macro:', solver_macro(j, d, tag, solver, Path(d.GetPathName).parent).replace('\n', ' | '))
    stop, seen = threading.Event(), []
    watch = threading.Thread(target=_solver_dialogs, args=(j.inst.pid, stop, seen), daemon=True)
    watch.start()
    lock = heavy_solve_lock(f'{Path(d.GetPathName).stem}/{name}') if nodes > HEAVY_NODES else contextlib.nullcontext()
    try:
        with lock:
            rc = call(st, 'RunAnalysis')
    finally:
        stop.set()
        watch.join(5)
    excessive = any(k == 'excessive' for k, _ in seen)
    if excessive and not loose_ok:
        try:
            sm.DeleteStudy(tag)                    # or the next run cannot make a study of this name
        except Exception as ex:      # noqa: BLE001
            log(f'{name}: study not deleted ({str(ex)[:80]})')
        raise Failed(f'{name}: the solver reported excessive displacements: a body is free to move, or held only by '
                     'something very soft. playbook/05-fea.md, "Contact between bodies"')
    if any(k == 'noconverge' for k, _ in seen):    # the solver still writes a result, with a clean reaction: never read it
        raise Failed(f'{name}: the contact iteration did not converge ("Failure to achieve equilibrium"): a body with '
                     'nothing to decide which way it goes. Move the pads, or load it the way that seats it. '
                     'playbook/05-fea.md, "Contact between bodies"')
    res = st.Results
    if rc or res is None:
        raise Failed(f'{name}: solve failed ({rc}). 24 is a singular model (a body free to move) or out of memory: '
                     'playbook/05-fea.md, "When the solve fails"')
    raw = _arr(call(mesh, 'GetNodes'), 4)
    xyz = dict(zip(raw[:, 0].astype(int), raw[:, 1:] * 1000))
    s = _arr(res.GetStress(0, 1, NUL, 3, L()), 12)       # 3 = N/mm2
    pos = np.array([xyz[int(i)] for i in s[:, 0]])

    def face_nodes(fs):
        try:
            q = _arr(res.GetStressForEntities2(True, 9, 1, NUL, fs, 3, L()), 2)
            return np.array([xyz[int(i)] for i in q[:, 0] if int(i) in xyz])
        except Exception as ex:      # noqa: BLE001 - has failed on contact models; the caller is told
            log(f'{name}: face nodes not read ({str(ex)[:80]}): peaks are NOT cleared of fixtures and loads')
            return None

    fixed_pts, loaded_pts = face_nodes(fixed), face_nodes(loaded)
    for label, pts in (('fixture', fixed_pts), ('load', loaded_pts)):      # a wrong face shows here before it shows anywhere
        if pts is not None and len(pts):
            log(f'{name}: {label} nodes {len(pts)}, box {pts.min(axis=0).round(2).tolist()} to {pts.max(axis=0).round(2).tolist()}')
    disp = reaction = None
    try:
        disp = _arr(res.GetTranslationalDisplacement(1, NUL, 0, L()), 5)       # last argument: 0 mm, 1 cm, 2 m, 3 inch
    except Exception as ex:      # noqa: BLE001
        log(f'{name}: displacements not read ({str(ex)[:80]})')
    try:
        # per node: id, Fx Fy Fz Fres, Mx My Mz Mres; zero except on restrained nodes. Last argument 0 = N (1 = lbf).
        # GetReactionForces2 does not exist on SolidWorks 2026.
        q = _arr(res.GetReactionForcesAndMoments(0, NUL, 0, L()), 9)
        f = q[:, 1:4].sum(axis=0)
        reaction = [round(float(v), 3) for v in f] + [round(float(np.linalg.norm(f)), 3)]
    except Exception as ex:      # noqa: BLE001
        log(f'{name}: reactions not read ({str(ex)[:80]})')
    extra = post(st, res) if post is not None else None
    if not keep_study and os.environ.get('SWFEA_KEEP') != '1':
        try:
            sm.DeleteStudy(tag)
        except Exception:      # noqa: BLE001 - the study staying in the model only costs file size
            pass
    # A document closed unsaved after a study and opened again in the same instance fails its next solve at once with
    # error 24, the solver stopping while it loads its input (selftest beam then loads, 2026-11-12). Saved, it does not.
    _save_as_is(d)
    r = Result(name, el, pos, s, fixed_pts, loaded_pts, disp, reaction, nodes, elements, time.time() - t0, applied)
    r.extra, r.excessive = extra, excessive
    return r


def converge(run, sizes, tol=0.05, layers=None, mask=None):
    """Solve at each element size in turn (coarse to fine) until the peak away from fixtures moves by under tol.

    run(el) -> Result. Returns the list of (el, nodes, peak) rows and whether it converged. With layers = the print
    layer normal, each row also carries the tension across layers and the shear between them, and both must settle
    too. mask(r) -> a node mask, to follow one body of several; it is combined with the exclusion distance. The peak is taken outside the
    same distance from fixtures and loads at every size (two of the coarsest elements), which can cover a real peak
    beside a fixture: read such a feature yourself with in_box() at each size. At least three sizes are always solved:
    two rows that agree can stop before a slow climb shows. A peak that keeps climbing as
    the mesh shrinks is a singularity (a sharp re-entrant corner or a fixture edge), not a stress: change the geometry
    (add the real fillet) or the mask, do not report the last number.
    """
    rows = []
    dist = 2.0 * max(sizes)       # one exclusion distance for the whole series, set by the coarsest mesh
    for el in sizes:
        r = run(el)
        keep = r.away(dist=dist)
        if mask is not None:
            keep &= mask(r)
        row = (el, r.nodes, round(r.peak(keep)[0], 2))
        rows.append(row if layers is None else row + (round(r.layer_stress(layers, keep)[0], 2),
                                                      round(r.layer_shear(layers, keep)[0], 2)))
        log('converge', rows[-1])
        if len(rows) > 2 and all(abs(a - b) <= tol * abs(b) for a, b in zip(rows[-1][2:], rows[-2][2:])):
            return rows, True
    return rows, False


def body_named(d, part):
    """The solid body whose name contains part (insert_body names a body "<file>-<its name in that file>")."""
    hit = [b for b in solid_bodies(d) if part.lower() in b.Name.lower()]
    if len(hit) != 1:
        raise Failed(f'{len(hit)} bodies match "{part}": {[b.Name for b in solid_bodies(d)]}')
    return hit[0]

