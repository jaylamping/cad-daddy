diff --git a/tools/solidworks/playbook/eval/luna-b/b3_variant.py b/tools/solidworks/playbook/eval/luna-b/b3_variant.py
new file mode 100644
index 0000000000000000000000000000000000000000..7288b0010c1d7851a480f87273716ca9fd00ccdf
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-b/b3_variant.py
@@ -0,0 +1,186 @@
+"""Build and evaluate one lighter B3 candidate. Args: wall thickness mm, arm bottom z mm (default 40)."""
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+SIM = ROOT / 'cad' / '_sim' / 'sw-eval' / 'luna-b'
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swkit import MID, Sk, bbox, bodies, expect, export, extrude, feature_errors, face_info, job, new_part, pick, plane, save, single_body, volume, edges_where, fillet, close, open_doc  # noqa: E402
+from swfea import PETG, converge, static  # noqa: E402
+
+SIZES = (4.0, 3.5, 3.0)
+AXES = {'X': (1, 0, 0), 'Y': (0, 1, 0), 'Z': (0, 0, 1)}
+
+
+def name_token(v):
+    return str(v).replace('.', 'p')
+
+
+def main():
+    t = float(sys.argv[1])
+    bottom = float(sys.argv[2]) if len(sys.argv) > 2 else 40.0
+    top = 52.0
+    h = top - bottom
+    if not (1.5 <= t <= 5.0 and 8.0 <= h <= 12.0):
+        raise ValueError(f'candidate outside intended search bounds: thickness={t}, arm height={h}')
+    token = f't{name_token(t)}_h{name_token(h)}'
+    model_path = CAD / f'wall_bracket_light_{token}.SLDPRT'
+    stl_path = CAD / f'wall_bracket_light_{token}.stl'
+    out_path = RUN / f'b3_{token}.json'
+    expected_volume = (t * 13.5 * 49.5 + (65 - t) * 10 * h
+                       + 2 * 3 ** 2 * (1 - math.pi / 4) * 10
+                       - (55 - 50) * 10 * 0.1 - 2 * math.pi * 2.25 ** 2 * t)
+    nominal_root = 60 * (60 - t) * (h / 2) / (10 * h ** 3 / 12)
+    span = 65 - t
+    e_mpa = PETG['EX'] / 1e6
+    inertia = 10 * h ** 3 / 12
+    w = 6.0
+    bending = w / (6 * e_mpa * inertia) * ((span * span ** 3 - span ** 4 / 4)
+                                                - (span * (span - 10) ** 3 - (span - 10) ** 4 / 4))
+    shear = (60 * (span - 10) + w * 10 ** 2 / 2) / ((5 / 6) * e_mpa / (2 * (1 + PETG['NUXY'])) * (10 * h))
+    hand_tip = bending + shear
+
+    with job(wait_s=1800) as j:
+        if model_path.exists():
+            model_path.unlink()
+        d = new_part(j.sw, model_path)
+        with Sk(d, plane(d, 'X', t / 2, 'WALL_P'), 'WALL') as s:
+            s.rect((t / 2, 13.25, 5.25), (t / 2, 26.75, 54.75))
+        extrude(d, s.feat, 'WALL', t, mode=MID, expect_dv=t * 13.5 * 49.5)
+        save(d)
+
+        with Sk(d, plane(d, 'X', (t + 65) / 2, 'ARM_P'), 'ARM') as s:
+            s.rect(((t + 65) / 2, 15, bottom), ((t + 65) / 2, 25, top))
+        extrude(d, s.feat, 'ARM', 65 - t, mode=MID, expect_dv=(65 - t) * 10 * h)
+        save(d)
+
+        root = edges_where(d, lambda p: abs(p[0] - t) < 0.02
+                           and min(abs(p[2] - bottom), abs(p[2] - top)) < 0.02
+                           and 14.9 <= p[1] <= 25.1)
+        expect('root edges', len(root), 2, 0)
+        if fillet(d, root, (3.0,), 'ROOT_FILLET') is None:
+            raise RuntimeError('R3 root fillet failed')
+        save(d)
+
+        step_x = 50.0
+        step_dv = (55.0 - step_x) * 10 * 0.1
+        with Sk(d, plane(d, 'Z', 51.95, 'LOAD_STEP_P'), 'LOAD_STEP') as s:
+            s.rect((step_x, 14.0, 51.95), (55.0, 26.0, 51.95))
+        extrude(d, s.feat, 'LOAD_STEP', 0.1, cut=True, mode=MID, expect_dv=step_dv)
+        save(d)
+
+        with Sk(d, plane(d, 'X', t / 2, 'SCREW_P'), 'SCREWS') as s:
+            s.circle((t / 2, 20, 12), 2.25)
+            s.circle((t / 2, 20, 48), 2.25)
+        extrude(d, s.feat, 'SCREW_HOLES', t, cut=True, mode=MID, expect_dv=2 * math.pi * 2.25 ** 2 * t)
+        save(d)
+        if feature_errors(d):
+            raise RuntimeError(f'feature errors: {feature_errors(d)}')
+        single_body(d)
+        expect('one body', len(bodies(d)), 1, 0)
+        expect('volume mm3', volume(d), expected_volume, 0.1)
+        bb = bbox(d)
+        for i, want in enumerate((0, 13.25, 5.25, 65, 26.75, 54.75)):
+            expect(f'bbox[{i}]', bb[i], want, 0.02)
+        holes = pick(d, kind='cyl', r=2.25)
+        expect('fixed holes after final rebuild', len(holes), 2, 0)
+        centers = sorted(tuple(round((face_info(f)['box'][i] + face_info(f)['box'][i + 3]) / 2, 2)
+                               for i in (1, 2)) for f in holes)
+        if centers != [(20.0, 12.0), (20.0, 48.0)]:
+            raise RuntimeError(f'fixed screw-hole centres changed: {centers}')
+        load = pick(d, kind='plane', normal=(0, 0, 1), at=(60, 20, 52), area=100)
+        expect('dedicated load patch', len(load), 1, 0)
+        expect('load patch area mm2', face_info(load[0])['area'], 100, 0.05)
+        wall = pick(d, kind='plane', normal=(-1, 0, 0), at=(0, 20, 30))
+        expect('fixed wall face', len(wall), 1, 0)
+        save(d)
+        export(j.sw, d, stl_path)
+
+        j.simulation()
+        close(j.sw, d)
+        d = open_doc(j.sw, model_path)
+        d.ForceRebuild3(False)
+        volume_mm3 = volume(d)
+        print(f'PREDICT B3 {token}: nominal root={nominal_root:.3f} MPa; tip deflection={hand_tip:.3f} mm; '
+              f'peak near root; expected nodes at {SIZES}: '
+              + ', '.join(str(round(12 * volume_mm3 / el ** 3)) for el in SIZES), flush=True)
+        results = []
+
+        def runner(el):
+            holes = pick(d, kind='cyl', r=2.25)
+            load = pick(d, kind='plane', normal=(0, 0, 1), at=(60, 20, 52), area=100)
+            expect(f'fixture walls el={el}', len(holes), 2, 0)
+            expect(f'load patch el={el}', len(load), 1, 0)
+            print(f'PREDICT B3 {token} el={el}: nodes={round(12 * volume_mm3 / el ** 3)}; '
+                  f'peak near root, displacement about {hand_tip:.3f} mm', flush=True)
+            r = static(j, d, f'{token}_{el:.2f}', PETG, fixtures=[('fixed', holes)], loads=[('normal', load, 60.0)],
+                       el=el, ctrl=[(holes, 1.0), (load, 1.0)], max_nodes=199999)
+            results.append(r)
+            SIM.mkdir(parents=True, exist_ok=True)
+            np.savez_compressed(SIM / f'B3_{token}_{el:.2f}.npz', pos=r.pos, stress=r.s,
+                                displacement=r.disp, fixed_points=r.fixed_pts, loaded_points=r.loaded_pts)
+            return r
+
+        helper_rows, helper_converged_z = converge(runner, SIZES, tol=0.05, layers=(0, 0, 1))
+        r = results[-1]
+        dist = 2 * max(SIZES)
+        orientation = {}
+        series_by_axis = {}
+        for axis, normal in AXES.items():
+            keep = r.away(dist=dist)
+            vm, vm_at = r.peak(keep)
+            ls, ls_at = r.layer_stress(normal, keep)
+            sh, sh_at = r.layer_shear(normal, keep)
+            values = []
+            for q in results:
+                m = q.away(dist=dist)
+                values.append([q.peak(m)[0], q.layer_stress(normal, m)[0], q.layer_shear(normal, m)[0]])
+            a, b = np.asarray(values[-2]), np.asarray(values[-1])
+            conv = bool(np.all(np.abs(b - a) <= 0.05 * np.maximum(np.abs(b), 1e-9)))
+            orientation[axis] = {'peak_vm_mpa': vm, 'peak_vm_at_mm': vm_at,
+                                 'layer_stress_mpa': ls, 'layer_stress_at_mm': ls_at,
+                                 'layer_shear_mpa': sh, 'layer_shear_at_mm': sh_at,
+                                 'sf_yield': 45 / vm, 'sf_layer': 22.5 / ls if ls > 0 else None,
+                                 'sf_shear': 13 / sh if sh > 0 else None, 'converged_all_three': conv}
+            series_by_axis[axis] = values
+        eligible = [axis for axis in AXES if orientation[axis]['converged_all_three']]
+        best = max(eligible, key=lambda axis: min(orientation[axis]['sf_yield'], orientation[axis]['sf_layer'],
+                                                  orientation[axis]['sf_shear']), default=None)
+        o = orientation[best] if best else None
+        roi = r.in_box([t, 13.0, bottom - 2, min(18.0, t + 15), 27.0, 54.0]) & r.away(dist=2.0)
+        roi_vm, roi_at = r.peak(roi)
+        result = {
+            'token': token, 'thickness_mm': t, 'arm_height_mm': h,
+            'volume_mm3': volume_mm3, 'mass_g': volume_mm3 * 0.00119,
+            'bbox_mm': bb, 'hand_root_stress_mpa': nominal_root, 'hand_tip_deflection_mm': hand_tip,
+            'print_orientation': f'layers stacked along {best}' if best else None,
+            'helper_mesh_series_z': helper_rows, 'helper_converged_z': helper_converged_z,
+            'orientation_table': orientation, 'series_by_axis': series_by_axis,
+            'nodes': r.nodes, 'peak_vm_mpa': o['peak_vm_mpa'] if o else None,
+            'peak_vm_at_mm': o['peak_vm_at_mm'] if o else None,
+            'root_roi_vm_mpa': roi_vm, 'root_roi_at_mm': roi_at,
+            'layer_stress_mpa': o['layer_stress_mpa'] if o else None,
+            'layer_shear_mpa': o['layer_shear_mpa'] if o else None,
+            'sf_yield': o['sf_yield'] if o else None, 'sf_layer': o['sf_layer'] if o else None,
+            'sf_shear': o['sf_shear'] if o else None,
+            'max_disp_mm': r.max_disp(), 'reaction_n': r.reaction[3] if r.reaction else None,
+            'converged': bool(o),
+        }
+        result['verdict'] = ('pass' if result['converged'] and abs(result['reaction_n'] - 60) <= 0.6
+                             and min(result['sf_yield'], result['sf_layer'], result['sf_shear']) >= 2
+                             else 'fail' if o and min(result['sf_yield'], result['sf_layer'], result['sf_shear']) < 2
+                             else 'not shown')
+        result['status'] = 'complete'
+        result['notes'] = 'Fixed screw-hole walls, normal load on exact 100 mm2 patch; see REPORT.md for limitations.'
+        (RUN / out_path.name).write_text(json.dumps(result, indent=2), encoding='utf-8')
+        print(json.dumps(result, indent=2), flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/solidworks/playbook/eval/luna-b/b4_tongue.py b/tools/solidworks/playbook/eval/luna-b/b4_tongue.py
new file mode 100644
index 0000000000000000000000000000000000000000..5c534ecd15c77788cfbaff38dab91c7f8260de0b
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-b/b4_tongue.py
@@ -0,0 +1,233 @@
+"""Build and solve the two-body tongue-in-slot contact case for B4."""
+import json
+import math
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+from scipy.spatial import Delaunay
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+SIM = ROOT / 'cad' / '_sim' / 'sw-eval' / 'luna-b'
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swkit import MID, NUL, L, Sk, bodies, bbox, close, expect, export, extrude, feature_errors, insert_body, job, new_part, open_doc, pick, plane, save, save_as, volume  # noqa: E402
+from swfea import NO_PENETRATION, BONDED, PETG, SOLVER_DIRECT, _arr, static  # noqa: E402
+
+BLOCK = CAD / 'tongue_slot_block.SLDPRT'
+TONGUE = CAD / 'tongue_slot_tongue.SLDPRT'
+PADS = [CAD / f'tongue_pad_{i}.SLDPRT' for i in range(4)]
+MODEL = CAD / 'tongue_slot.SLDPRT'
+CONTACT_MODEL = CAD / 'tongue_slot_contact.SLDPRT'
+PAD_MAT = {'name': 'B4 soft stabilizer', 'EX': 8.0e3, 'NUXY': 0.45, 'DENS': 1000.0,
+           'SIGYLD': 1.0e6, 'SIGXT': 1.0e6}
+SIZES = (4.0, 3.5, 3.0)
+
+
+def make_parts(j):
+    d = new_part(j.sw, BLOCK)
+    with Sk(d, plane(d, 'Z', 10.0, 'BLOCK_P'), 'BLOCK') as s:
+        s.rect((-20, -10, 10), (20, 10, 10))
+    extrude(d, s.feat, 'BLOCK', 20, mode=MID, expect_dv=8000)
+    with Sk(d, plane(d, 'Y', 0.0, 'SLOT_P'), 'SLOT') as s:
+        s.rect((-4.1, 0, 8), (4.1, 0, 20))
+    extrude(d, s.feat, 'SLOT', 20, cut=True, mode=MID, expect_dv=8.2 * 12 * 20)
+    save(d)
+    expect('block volume', volume(d), 6032, 0.001)
+    if feature_errors(d):
+        raise RuntimeError(f'block feature errors: {feature_errors(d)}')
+    close(j.sw, d)
+
+    d = new_part(j.sw, TONGUE)
+    with Sk(d, plane(d, 'Y', 0.0, 'TONGUE_P'), 'TONGUE') as s:
+        s.rect((-4, 0, 8.1), (4, 0, 40))
+    extrude(d, s.feat, 'TONGUE', 20, mode=MID, expect_dv=8 * 20 * 31.9)
+    # A shallow inset makes the Z30-40 loaded region its own -X-facing planar face.
+    with Sk(d, plane(d, 'X', -3.95, 'LOAD_PATCH_P'), 'LOAD_PATCH') as s:
+        s.rect((-3.95, -10, 30), (-3.95, 10, 40))
+    extrude(d, s.feat, 'LOAD_PATCH', 0.1, cut=True, mode=MID, expect_dv=20)
+    save(d)
+    expect('tongue volume with load relief', volume(d), 5084, 0.001)
+    if feature_errors(d):
+        raise RuntimeError(f'tongue feature errors: {feature_errors(d)}')
+    close(j.sw, d)
+
+    for i, (y, z) in enumerate(((-5, 24), (5, 24), (-5, 28), (5, 28))):
+        d = new_part(j.sw, PADS[i])
+        with Sk(d, plane(d, 'X', 6.0, f'PAD_P{i}'), f'PAD{i}') as s:
+            s.rect((6.0, y - 0.5, z - 0.5), (6.0, y + 0.5, z + 0.5))
+        extrude(d, s.feat, 'PAD', 4.0, mode=MID, expect_dv=4.0)
+        save(d)
+        close(j.sw, d)
+
+    d = open_doc(j.sw, BLOCK)
+    insert_body(d, TONGUE)
+    expect('physical bodies before supports', len(bodies(d)), 2, 0)
+    save(d)
+    export(j.sw, d, CAD / 'tongue_slot.stl')
+    close(j.sw, d)
+
+    d = open_doc(j.sw, BLOCK)
+    for p in [TONGUE, *PADS]:
+        insert_body(d, p)
+    expect('contact model bodies', len(bodies(d)), 6, 0)
+    if feature_errors(d):
+        raise RuntimeError(f'contact model feature errors: {feature_errors(d)}')
+    save(d)
+    save_as(d, CONTACT_MODEL)
+    close(j.sw, d)
+
+
+def tongue_mask(r):
+    p = r.pos
+    return ((p[:, 0] >= -4.02) & (p[:, 0] <= 4.02) & (p[:, 1] >= -10.02) & (p[:, 1] <= 10.02)
+            & (p[:, 2] >= 8.08) & (p[:, 2] <= 40.02))
+
+
+def section_fx(r, z0):
+    p = r.pos
+    mask = tongue_mask(r) & (np.abs(p[:, 2] - z0) <= 0.45)
+    xy = np.round(p[mask, :2], 3)
+    txz = r.s[mask, 5]  # Sxx,Syy,Szz,Txy,Txz,Tyz; integrate Txz over a Z-normal cut.
+    if len(xy) < 12:
+        raise RuntimeError(f'only {len(xy)} tongue nodes near cut Z={z0}')
+    unique, inv = np.unique(xy, axis=0, return_inverse=True)
+    tau = np.zeros(len(unique)); count = np.zeros(len(unique))
+    np.add.at(tau, inv, txz); np.add.at(count, inv, 1)
+    tau /= count
+    tri = Delaunay(unique, qhull_options='QJ')
+    total = 0.0
+    for ids in tri.simplices:
+        q = unique[ids]
+        if np.any(q[:, 0] < -4.01) or np.any(q[:, 0] > 4.01) or np.any(q[:, 1] < -10.01) or np.any(q[:, 1] > 10.01):
+            continue
+        area = abs(np.cross(q[1] - q[0], q[2] - q[0])) / 2
+        total += float(area * tau[ids].mean())
+    return total
+
+
+def forces_from_sections(r):
+    above = section_fx(r, 20.5)
+    below_top = section_fx(r, 19.5)
+    above_floor = section_fx(r, 8.5)
+    return {'v_above_slot_N': above, 'v_below_top_contact_N': below_top, 'v_above_floor_N': above_floor,
+            'right_wall_N': abs(above - below_top), 'left_wall_N': abs(above_floor)}
+
+
+def pad_reaction_post(st, res):
+    nodes = _arr(st.Mesh.GetNodes(), 4)
+    xyz = {int(row[0]): row[1:] * 1000 for row in nodes}
+    q = _arr(res.GetReactionForcesAndMoments(0, NUL, 0, L()), 9)
+    selected = []
+    for row in q:
+        p = xyz.get(int(row[0]))
+        if p is not None and abs(p[0] - 8.0) < 0.02 and 23.4 <= p[2] <= 28.6 and min(abs(p[1] - 5), abs(p[1] + 5)) <= 0.6:
+            selected.append(row[1:4])
+    force = np.sum(selected, axis=0) if selected else np.zeros(3)
+    return {'pad_reaction_vector_n': force.tolist(), 'pad_reaction_resultant_n': float(np.linalg.norm(force))}
+
+
+def main():
+    RUN.mkdir(parents=True, exist_ok=True); CAD.mkdir(parents=True, exist_ok=True); SIM.mkdir(parents=True, exist_ok=True)
+    started = time.time()
+    with job(wait_s=1800) as j:
+        make_parts(j)
+        j.simulation()
+        d = open_doc(j.sw, CONTACT_MODEL)
+        d.ForceRebuild3(False)
+        block_bottom = pick(d, kind='plane', normal=(0, 0, -1), at=(0, 0, 0))
+        wall_plus = pick(d, kind='plane', normal=(1, 0, 0), at=(4.1, 0, 14))
+        wall_minus = pick(d, kind='plane', normal=(-1, 0, 0), at=(-4.1, 0, 14))
+        tongue_plus = pick(d, kind='plane', normal=(1, 0, 0), at=(4.0, 0, 14))
+        tongue_minus = pick(d, kind='plane', normal=(-1, 0, 0), at=(-4.0, 0, 14))
+        load_face = pick(d, kind='plane', normal=(-1, 0, 0), at=(-3.9, 0, 35), area=200)
+        pad_fixed = []
+        for y, z in ((-5, 24), (5, 24), (-5, 28), (5, 28)):
+            fs = pick(d, kind='plane', normal=(1, 0, 0), at=(8, y, z), area=1)
+            expect(f'pad fixed face at Y{y} Z{z}', len(fs), 1, 0); pad_fixed += fs
+        for name, fs in (('block bottom', block_bottom), ('right slot wall', wall_plus), ('left slot wall', wall_minus),
+                         ('tongue right side', tongue_plus), ('tongue left side', tongue_minus), ('80N patch', load_face)):
+            expect(name + ' face count', len(fs), 1, 0)
+        contacts = [(NO_PENETRATION, wall_plus, tongue_plus), (NO_PENETRATION, wall_minus, tongue_minus)]
+        fixtures = [('fixed', block_bottom + pad_fixed)]
+        ctrl = [(wall_plus + wall_minus + tongue_plus + tongue_minus, 2.0), (load_face, 2.0)]
+        bounds = bbox(d)
+        print(f'B4 prediction: total volume about 11132 mm3; expected nodes at el=4/3.5/3 mm about '
+              f'{round(12*11132/4**3*1.5)}, {round(12*11132/3.5**3*1.5)}, {round(12*11132/3**3*1.5)}; '
+              'hand wall forces (left lower, right upper) about 101.2 N, 181.2 N; peak block stress near slot corners; '
+              'tip lateral displacement order 2-4 mm.', flush=True)
+        print('B4 assembly bounds', bounds, 'bodies', bodies(d), flush=True)
+
+        proof = static(j, d, 'B4_GAP_PROOF', PETG, fixtures=fixtures, loads=[('normal', load_face, 0.001)],
+                       el=4.0, ctrl=ctrl, contacts=contacts, materials={'PAD': PAD_MAT}, solver=SOLVER_DIRECT,
+                       max_nodes=199999, post=pad_reaction_post)
+        tm = tongue_mask(proof)
+        proof_shift = float(np.mean(proof.disp[tm & (proof.pos[:, 2] >= 10) & (proof.pos[:, 2] <= 18), 1]))
+        proof_pads = proof.extra
+        np.savez_compressed(SIM / 'B4_gap_proof.npz', pos=proof.pos, stress=proof.s, displacement=proof.disp,
+                            fixed_points=proof.fixed_pts, loaded_points=proof.loaded_pts)
+        print('B4 gap proof summary', proof.summary(), 'tongue mean UX at Z10-18', proof_shift,
+              'pad support reaction', proof_pads, flush=True)
+
+        rows = []
+        full_results = []
+        for el in SIZES:
+            r = static(j, d, f'B4_FULL_{el:.1f}', PETG, fixtures=fixtures,
+                       loads=[('normal', load_face, 80.0)], el=el, ctrl=ctrl, contacts=contacts,
+                       materials={'PAD': PAD_MAT}, solver=SOLVER_DIRECT, max_nodes=199999, post=pad_reaction_post)
+            forces = forces_from_sections(r)
+            p = r.pos; tongue = tongue_mask(r)
+            block_box = ((p[:, 0] >= -20.01) & (p[:, 0] <= 20.01) & (p[:, 1] >= -10.01) & (p[:, 1] <= 10.01)
+                         & (p[:, 2] >= -0.01) & (p[:, 2] <= 20.01))
+            slot_void = (np.abs(p[:, 0]) < 4.09) & (p[:, 2] > 8.01)
+            block = block_box & ~slot_void
+            peak_i = np.flatnonzero(block)[np.argmax(r.vm[block])]
+            tip = tongue & (p[:, 2] >= 39.8)
+            row = {'el_mm': el, 'nodes': r.nodes, 'elements': r.elements, 'reaction': r.reaction,
+                   'max_disp_mm': r.max_disp(), 'tip_ux_mm': float(r.disp[tip, 1].max()),
+                   'block_peak_vm_mpa': float(r.vm[peak_i]), 'block_peak_at_mm': p[peak_i].round(3).tolist(),
+                   'section_forces': forces, 'pad_reaction': r.extra}
+            rows.append(row); full_results.append(r)
+            np.savez_compressed(SIM / f'B4_full_{el:.1f}.npz', pos=r.pos, stress=r.s, displacement=r.disp,
+                                fixed_points=r.fixed_pts, loaded_points=r.loaded_pts)
+            print('B4 full row', json.dumps(row), flush=True)
+
+        fine = rows[-1]
+        hand_left, hand_right = 101.176470588, 181.176470588
+        wall = fine['section_forces']
+        section_balance = abs((wall['right_wall_N'] - wall['left_wall_N']) - 80.0) / 80.0
+        pad_share = fine['pad_reaction']['pad_reaction_resultant_n']
+        proof_ok = proof_shift >= 0.09
+        valid = (proof_ok and abs(fine['reaction'][3] - 80.0) <= 0.8 and pad_share <= 0.8
+                 and section_balance <= 0.05 and all(r.nodes < 200000 for r in full_results))
+        result = {
+            'hand_wall_forces_n': [hand_left, hand_right],
+            'wall_forces_n': [wall['left_wall_N'], wall['right_wall_N']],
+            'nodes': fine['nodes'], 'how_tongue_was_stabilised':
+                'Four 1 x 1 x 4 mm analysis-only pads on the tongue side at Z24/28,Y±5, fixed at X8; E=0.008 MPa. '
+                'At the 0.001 N +X contact proof they carry under the 0.001 N and permit the tongue to translate across the 0.1 mm clearance.',
+            'block_peak_vm_mpa': fine['block_peak_vm_mpa'], 'block_peak_at_mm': fine['block_peak_at_mm'],
+            'tongue_tip_disp_mm': fine['tip_ux_mm'], 'reaction_n': fine['reaction'][3],
+            'valid': bool(valid),
+            'why': {'gap_proof_mean_ux_mm': proof_shift, 'gap_proof_pad_reaction': proof_pads,
+                    'gap_proof_pass': proof_ok,
+                    'pad_reaction_n': pad_share, 'pad_share_pct': 100 * pad_share / 80,
+                    'section_force_balance_error_pct': 100 * section_balance,
+                    'contact_forces_by_section_n': wall,
+                    'hand_forces_n_left_right': [hand_left, hand_right],
+                    'mesh_series': rows,
+                    'mesh_node_counts_below_200k': all(r['nodes'] < 200000 for r in rows),
+                    'limitation': 'Nodal stresses were integrated over Delaunay triangulations of near-horizontal tongue-node slices; compare convergence across sizes.'},
+            'status': 'complete', 'notes': 'Two no-penetration wall contacts; direct sparse solver. See REPORT.md for the contact proof, section-force method, and convergence.'}
+        (RUN / 'b4_result.json').write_text(json.dumps(result, indent=2), encoding='utf-8')
+        main = json.loads((RUN / 'results.json').read_text(encoding='utf-8'))
+        main['B4'] = result
+        (RUN / 'results.json').write_text(json.dumps(main, indent=2), encoding='utf-8')
+        close(j.sw, d)
+    print('B4 elapsed seconds', round(time.time() - started, 1), flush=True)
+
+
+if __name__ == '__main__':
+    main()
