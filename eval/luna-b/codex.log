@@ -0,0 +1,21 @@
+"""Check B2's exported STL against the SolidWorks volume and bounding box."""
+import json
+from pathlib import Path
+
+import trimesh
+
+RUN = Path(__file__).resolve().parent
+CAD = Path(__file__).resolve().parents[5] / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+sw_volume = 19034.5852
+sw_box = [0.0, 0.0, 0.0, 65.0, 40.0, 60.0]
+mesh = trimesh.load(CAD / 'wall_bracket.stl', force='mesh')
+box = mesh.bounds.reshape(-1).tolist()
+out = {'watertight': bool(mesh.is_watertight), 'shells': len(mesh.split(only_watertight=False)),
+       'stl_volume_mm3': float(mesh.volume), 'solidworks_volume_mm3': sw_volume,
+       'volume_error_pct': 100 * abs(float(mesh.volume) - sw_volume) / sw_volume,
+       'bounds_mm': box, 'solidworks_bounds_mm': sw_box,
+       'max_bbox_delta_mm': max(abs(a - b) for a, b in zip(box, sw_box)), 'triangles': len(mesh.faces)}
+if not out['watertight'] or out['shells'] != 1 or out['volume_error_pct'] > 0.5 or out['max_bbox_delta_mm'] > 0.1:
+    raise RuntimeError(f'B2 STL check failed: {out}')
+(RUN / 'b2_stl_checks.json').write_text(json.dumps(out, indent=2), encoding='utf-8')
+print(json.dumps(out, indent=2), flush=True)
diff --git a/tools/solidworks/playbook/eval/luna-b/b2_support_refine.py b/tools/solidworks/playbook/eval/luna-b/b2_support_refine.py
new file mode 100644
index 0000000000000000000000000000000000000000..316a8dbad81e091c07cae07b1d3cf1e2741049e8
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-b/b2_support_refine.py
@@ -0,0 +1,87 @@
+"""B2 support sensitivity refinement, one second-support mesh series."""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+SIM = ROOT / 'cad' / '_sim' / 'sw-eval' / 'luna-b'
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swkit import job, open_doc, pick, face_info, expect  # noqa: E402
+from swfea import PETG, converge, static  # noqa: E402
+
+SIZES = (4.0, 3.5, 3.0)
+AXES = {'X': (1, 0, 0), 'Y': (0, 1, 0), 'Z': (0, 0, 1)}
+
+
+def main():
+    with job(wait_s=1800) as j:
+        j.simulation()
+        d = open_doc(j.sw, CAD / 'wall_bracket.SLDPRT')
+        d.ForceRebuild3(False)
+        load = pick(d, kind='plane', normal=(0, 0, 1), at=(60, 20, 52), area=100)
+        backing = pick(d, kind='plane', normal=(-1, 0, 0), at=(0, 20, 30))
+        expect('load patch count', len(load), 1, 0)
+        expect('back wall face count', len(backing), 1, 0)
+        volume = sum(b.GetMassProperties(1000.0)[3] for b in d.GetBodies2(0, True)) * 1e9
+        results = []
+
+        def runner(el):
+            # Re-pick after each result/save; COM faces can go stale across a study rebuild.
+            load = pick(d, kind='plane', normal=(0, 0, 1), at=(60, 20, 52), area=100)
+            backing = pick(d, kind='plane', normal=(-1, 0, 0), at=(0, 20, 30))
+            expect(f'load patch at el={el}', len(load), 1, 0)
+            expect(f'back wall at el={el}', len(backing), 1, 0)
+            estimate = round(12 * volume / el ** 3)
+            print(f'PREDICT B2 second support el={el} mm nodes={estimate}; peak near root fillet; displacement about 1.4 mm', flush=True)
+            r = static(j, d, f'B2_wall_{el:.2f}', PETG, fixtures=[('fixed', backing)],
+                       loads=[('normal', load, 60.0)], el=el, ctrl=[(load, 1.0)], max_nodes=199999)
+            results.append(r)
+            SIM.mkdir(parents=True, exist_ok=True)
+            np.savez_compressed(SIM / f'B2_wall_{el:.2f}.npz', pos=r.pos, stress=r.s, displacement=r.disp,
+                                fixed_points=r.fixed_pts, loaded_points=r.loaded_pts)
+            return r
+
+        # The Z-normal layer series was converged under the hole-wall support; run the same convergence test for this
+        # longer back-face support before comparing the physical quantity.
+        helper_rows, converged_z = converge(runner, SIZES, tol=0.05, layers=(0, 0, 1))
+        r = results[-1]
+        dist = 2 * max(SIZES)
+        orientation = {}
+        all_series = {}
+        for axis, normal in AXES.items():
+            keep = r.away(dist=dist)
+            vm, vm_at = r.peak(keep)
+            ls, ls_at = r.layer_stress(normal, keep)
+            sh, sh_at = r.layer_shear(normal, keep)
+            series = []
+            for q in results:
+                m = q.away(dist=dist)
+                series.append([q.peak(m)[0], q.layer_stress(normal, m)[0], q.layer_shear(normal, m)[0]])
+            prev, last = np.array(series[-2]), np.array(series[-1])
+            is_conv = bool(np.all(np.abs(last - prev) <= 0.05 * np.maximum(np.abs(last), 1e-9)))
+            orientation[axis] = {'peak_vm_mpa': vm, 'peak_vm_at_mm': vm_at,
+                                 'layer_stress_mpa': ls, 'layer_stress_at_mm': ls_at,
+                                 'layer_shear_mpa': sh, 'layer_shear_at_mm': sh_at,
+                                 'sf_yield': 45 / vm, 'sf_layer': 22.5 / ls if ls > 0 else None,
+                                 'sf_shear': 13 / sh if sh > 0 else None,
+                                 'converged_all_three': is_conv}
+            all_series[axis] = series
+        best = max((a for a in orientation if orientation[a]['converged_all_three']),
+                   key=lambda a: min(orientation[a]['sf_yield'], orientation[a]['sf_layer'], orientation[a]['sf_shear']),
+                   default=None)
+        output = {'mesh_series_helper': helper_rows, 'converged_z_from_helper': converged_z,
+                  'orientation_series': all_series, 'orientation_table': orientation,
+                  'nodes': r.nodes, 'reaction_n': r.reaction[3] if r.reaction else None,
+                  'max_disp_mm': r.max_disp(), 'best_converged_orientation': best}
+        if best:
+            output['best_orientation_factors'] = orientation[best]
+        (RUN / 'b2_support_result.json').write_text(json.dumps(output, indent=2), encoding='utf-8')
+        print(json.dumps(output, indent=2), flush=True)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/solidworks/playbook/eval/luna-b/b3_exclusion_sweep.py b/tools/solidworks/playbook/eval/luna-b/b3_exclusion_sweep.py
new file mode 100644
index 0000000000000000000000000000000000000000..2d4d0053a20b8d7932fd6dd5eb2d4bc5fe7b8939
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-b/b3_exclusion_sweep.py
@@ -0,0 +1,47 @@
+"""Check whether the B3 fixed-hole exclusion distance is hiding the layer-shear peak."""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+SIM = ROOT / 'cad' / '_sim' / 'sw-eval' / 'luna-b'
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swfea import Result  # noqa: E402
+
+files = {
+    4.0: 'B3_t3p0_h12p0_4.00.npz', 3.5: 'B3_t3p0_h12p0_3.50.npz',
+    3.0: 'B3_t3p0_h12p0_3.00.npz', 2.5: 'B3_t3_refine_2.50.npz',
+    2.0: 'B3_t3_fine_2.00.npz', 1.5: 'B3_t3_fine_1.50.npz', 1.2: 'B3_t3_fine_1.20.npz',
+}
+series_by_distance = {}
+for dist in (8.0, 10.0, 12.0):
+    rows = []
+    for el, filename in files.items():
+      with np.load(SIM / filename) as data:
+        r = Result(f'B3_fine_{el}', el, data['pos'], data['stress'], data['fixed_points'], data['loaded_points'],
+                   data['displacement'], [0.0, 0.0, 60.0, 60.0], len(data['pos']), 0, 0, 60.0)
+      keep = r.away(dist=dist)
+      vm, vm_at = r.peak(keep)
+      orientation = {}
+      for axis, n in {'X': (1, 0, 0), 'Y': (0, 1, 0), 'Z': (0, 0, 1)}.items():
+          ls, ls_at = r.layer_stress(n, keep)
+          sh, sh_at = r.layer_shear(n, keep)
+          orientation[axis] = {'layer_tension_mpa': ls, 'layer_tension_at_mm': ls_at,
+                               'layer_shear_mpa': sh, 'layer_shear_at_mm': sh_at,
+                               'sf_yield': 45 / vm, 'sf_layer': 22.5 / ls if ls > 0 else None,
+                               'sf_shear': 13 / sh if sh > 0 else None}
+      rows.append({'el_mm': el, 'nodes': len(r.pos), 'peak_vm_mpa': vm, 'peak_vm_at_mm': vm_at,
+                   'orientations': orientation})
+    last, prev = rows[-1], rows[-2]
+    convergence = {}
+    for axis in ('X', 'Y', 'Z'):
+        a = [last['peak_vm_mpa'], last['orientations'][axis]['layer_tension_mpa'], last['orientations'][axis]['layer_shear_mpa']]
+        b = [prev['peak_vm_mpa'], prev['orientations'][axis]['layer_tension_mpa'], prev['orientations'][axis]['layer_shear_mpa']]
+        convergence[axis] = [abs(x-y) / max(abs(x), 1e-9) <= 0.05 for x, y in zip(a,b)]
+    series_by_distance[str(dist)] = {'series': rows, 'last_step_convergence': convergence}
+out = {'exclusion_distances_mm': [8.0, 10.0, 12.0], 'series_by_common_distance': series_by_distance}
+(RUN / 'b3_exclusion_sweep.json').write_text(json.dumps(out, indent=2), encoding='utf-8')
+print(json.dumps(out, indent=2), flush=True)
diff --git a/tools/solidworks/playbook/eval/luna-b/b3_refine_y.py b/tools/solidworks/playbook/eval/luna-b/b3_refine_y.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea531108a1c7efe8fda2ce8ad55d8a192ee18cda
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-b/b3_refine_y.py
@@ -0,0 +1,82 @@
+"""Refine B3 t3/h12 for the Y layer orientation, which was near an FoS of 2 but not yet converged."""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / 'cad' / '_wip' / 'sw-eval' / 'luna-b'
+SIM = ROOT / 'cad' / '_sim' / 'sw-eval' / 'luna-b'
+MODEL = CAD / 'wall_bracket_light_t3p0_h12p0.SLDPRT'
+SIZES = (3.0, 2.5, 2.0)
+AXES = {'X': (1, 0, 0), 'Y': (0, 1, 0), 'Z': (0, 0, 1)}
+sys.path.insert(0, str(ROOT / 'tools' / 'solidworks'))
+from swkit import expect, job, open_doc, pick, volume  # noqa: E402
+from swfea import PETG, converge, static  # noqa: E402
+
+
+def main():
+    with job(wait_s=1800) as j:
+        j.simulation()
+        d = open_doc(j.sw, MODEL)
+        d.ForceRebuild3(False)
+        volume_mm3 = volume(d)
+        results = []
+
+        def runner(el):
+            holes = pick(d, kind='cyl', r=2.25)
+            load = pick(d, kind='plane', normal=(0, 0, 1), at=(60, 20, 52), area=100)
+            expect(f'hole fixture faces el={el}', len(holes), 2, 0)
+            expect(f'load patch faces el={el}', len(load), 1, 0)
+            estimate = round(12 * volume_mm3 / el ** 3)
+            print(f'PREDICT B3 refine el={el}: {estimate} nodes; test Y layer tension/shear stability, '
+                  'peak near the arm root', flush=True)
+            r = static(j, d, f'B3_t3_refine_{el:.2f}', PETG,
+                       fixtures=[('fixed', holes)], loads=[('normal', load, 60.0)], el=el,
+                       ctrl=[(holes, 1.0), (load, 1.0)], max_nodes=199999)
+            results.append(r)
+            SIM.mkdir(parents=True, exist_ok=True)
+            np.savez_compressed(SIM / f'B3_t3_refine_{el:.2f}.npz', pos=r.pos, stress=r.s, displacement=r.disp,
+                                fixed_points=r.fixed_pts, loaded_points=r.loaded_pts)
+            return r
+
+        helper_rows, helper_converged_y = converge(runner, SIZES, tol=0.05, layers=(0, 1, 0))
+        final = results[-1]
+        dist = 2 * max(SIZES)
+        orientation = {}
+        series_by_axis = {}
+        for axis, n in AXES.items():
+            keep = final.away(dist=dist)
+            vm, vm_at = final.peak(keep)
+            ls, ls_at = final.layer_stress(n, keep)
+            sh, sh_at = final.layer_shear(n, keep)
+            series = []
+            for r in results:
+                m = r.away(dist=dist)
+                series.append([r.peak(m)[0], r.layer_stress(n, m)[0], r.layer_shear(n, m)[0]])
+            a, b = np.asarray(series[-2]), np.asarray(series[-1])
+            conv = bool(np.all(np.abs(b - a) <= 0.05 * np.maximum(np.abs(b), 1e-9)))
+            orientation[axis] = {'peak_vm_mpa': vm, 'peak_vm_at_mm': vm_at,
+                                 'layer_stress_mpa': ls, 'layer_stress_at_mm': ls_at,
+                                 'layer_shear_mpa': sh, 'layer_shear_at_mm': sh_at,
+                                 'sf_yield': 45 / vm, 'sf_layer': 22.5 / ls if ls > 0 else None,
+                                 'sf_shear': 13 / sh if sh > 0 else None, 'converged_all_three': conv}
+            series_by_axis[axis] = series
+        eligible = [a for a in AXES if orientation[a]['converged_all_three']]
+        best = max(eligible, key=lambda a: min(orientation[a]['sf_yield'], orientation[a]['sf_layer'],
+                                               orientation[a]['sf_shear']), default=None)
+        output = {'candidate': 't3p0_h12p0', 'sizes_mm': SIZES, 'helper_rows_y': helper_rows,
+                  'helper_converged_y': helper_converged_y, 'orientation_table': orientation,
+                  'series_by_axis': series_by_axis, 'nodes': final.nodes,
+                  'reaction_n': final.reaction[3] if final.reaction else None,
+                  'max_disp_mm': final.max_disp(), 'best_converged_orientation': best}
+        if best:
+            output['best_orientation_factors'] = orientation[best]
+        (RUN / 'b3_refine_y.json').write_text(json.dumps(output, indent=2), encoding='utf-8')
+        print(json.dumps(output, indent=2), flush=True)
+
+
+if __name__ == '__main__':
+    main()
