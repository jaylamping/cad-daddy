        area_total+=a; force+=a*tau[ids].mean();nt+=1
    print(z0,'nodes',len(xy),'unique',len(u),'area',round(area_total,2),'tri',nt,'fx',round(force,2),'tau',round(float(tau.min()),2),round(float(tau.max()),2))
