+++ b/tools/solidworks/playbook/eval/luna-c/c2_idea_a.py
@@ -0,0 +1,103 @@
+"""Idea A: a continuous tapered leaf spine with an open, flush cable channel."""
+import json
+import math
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[5]
+TOOLS = ROOT / "tools" / "solidworks"
+WIP = ROOT / "cad" / "_wip" / "sw-eval" / "luna-c"
+RUN = ROOT / "tools" / "solidworks" / "playbook" / "eval" / "luna-c"
+sys.path.insert(0, str(TOOLS))
+from swkit import BLIND, MID, Sk, bbox, bodies, call, export, extrude, feature_errors, job, loft, new_part, pick, plane, save, single_body, volume
+
+
+def build(j, model):
+    d = new_part(j.sw, model)
+
+    # The elbow interface is identical to C1: Ø70 disc, Ø30 bore and six Ø3.4 holes on Ø50 PCD.
+    with Sk(d, plane(d, "Y", 0.0, "ELBOW_MID"), "ELBOW_DISC") as s:
+        s.circle((0, 0, 0), 35.0)
+    extrude(d, s.feat, "ELBOW_DISC", 8.0, mode=MID, expect_dv=math.pi * 35**2 * 8)
+    save(d)
+    with Sk(d, plane(d, "Y", 0.0, "BORE_MID"), "BORE") as s:
+        s.circle((0, 0, 0), 15.0)
+    extrude(d, s.feat, "LOCATING_BORE", 8.0, cut=True, mode=MID, expect_dv=math.pi * 15**2 * 8)
+    save(d)
+    with Sk(d, plane(d, "Y", 0.0, "BOLT_MID"), "BOLTS") as s:
+        for k in range(6):
+            a = math.radians(60 * k)
+            s.circle((25 * math.cos(a), 0, 25 * math.sin(a)), 1.7)
+    extrude(d, s.feat, "BOLT_HOLES", 8.0, cut=True, mode=MID, expect_dv=6 * math.pi * 1.7**2 * 8)
+    save(d)
+
+    # Four aligned open curves per section avoid the overshoot seen with closed spline loops.
+    sections = []
+    section_data = [(-32.0, 14.0, -11.0, 7.0), (-45.0, 17.0, -12.0, 7.0),
+                    (-80.0, 14.0, -11.0, 7.0), (-120.0, 14.0, -11.0, 7.0),
+                    (-150.0, 14.0, -11.0, 7.0), (-169.0, 17.0, -13.0, 11.0),
+                    (-174.0, 19.0, -17.0, 17.0), (-180.0, 20.0, -22.0, 22.0)]
+    for idx, (z, w, y0, y1) in enumerate(section_data):
+        r = min(2.5, w * 0.2, (y1 - y0) * 0.2)
+        ym = (y0 + y1) / 2.0
+        curves = [
+            [(0, y1, z), (0.7 * w, y1, z), (w, ym + 0.7 * (y1 - ym), z), (w, ym, z)],
+            [(w, ym, z), (w, ym - 0.7 * (ym - y0), z), (0.7 * w, y0, z), (0, y0, z)],
+            [(0, y0, z), (-0.7 * w, y0, z), (-w, ym - 0.7 * (ym - y0), z), (-w, ym, z)],
+            [(-w, ym, z), (-w, ym + 0.7 * (y1 - ym), z), (-0.7 * w, y1, z), (0, y1, z)],
+        ]
+        with Sk(d, plane(d, "Z", z, f"SPINE_{idx}_P"), f"SPINE_{idx}") as s:
+            for curve in curves:
+                s.spline(curve, closed=False)
+        sections.append(s.feat)
+    loft(d, sections, "LEAF_SPINE_AND_WRIST_HUB")
+    save(d)
+
+    # Elbow-to-wrist cable path: a 6 mm wide open slot and a Ø6 round bottom, centred at X=9, Y=4.
+    # It opens through the wide wrist hub and exits into the fork slot.
+    with Sk(d, plane(d, "Z", -90.0, "CABLE_OPEN_MID"), "CABLE_OPEN") as s:
+        s.rect((6.0, 4.0, -90.0), (12.0, 22.0, -90.0))
+    extrude(d, s.feat, "CABLE_OPENING", 180.0, cut=True, mode=MID)
+    save(d)
+    with Sk(d, plane(d, "Z", -90.0, "CABLE_ROUND_MID"), "CABLE_ROUND") as s:
+        s.circle((9.0, 4.0, -90.0), 3.0)
+    extrude(d, s.feat, "CABLE_ROUND_GROOVE", 180.0, cut=True, mode=MID)
+    save(d)
+
+    # Matching oval cheeks, flat on the inside at Y=±16; the slot starts below Z=-180.
+    for label, y0, sign in (("CHEEK_POS", 16.0, 1), ("CHEEK_NEG", -16.0, -1)):
+        pts = [(18.0 * math.cos(math.radians(a)), y0,
+                -195.0 + 20.0 * math.sin(math.radians(a))) for a in range(0, 360, 22)]
+        with Sk(d, plane(d, "Y", y0, label + "_P"), label) as s:
+            s.spline(pts)
+        extrude(d, s.feat, label, 6.0, mode=BLIND, want=(1, sign, y0))
+        save(d)
+
+    with Sk(d, plane(d, "Y", 0.0, "PIN_MID"), "PIN_HOLE") as s:
+        s.circle((0.0, 0.0, -200.0), 4.0)
+    extrude(d, s.feat, "WRIST_PIN_HOLE", 50.0, cut=True, mode=MID)
+    save(d)
+    single_body(d)
+    errs = feature_errors(d)
+    if errs:
+        raise RuntimeError(f"feature errors: {errs}")
+    return d
+
+
+def main():
+    model = WIP / "idea_a.SLDPRT"
+    with job(wait_s=1800) as j:
+        subprocess.run([sys.executable, str(ROOT / "tools" / "pc" / "claims.py"), "beat", "sw-eval-luna-c",
+                        "--status", "C2 idea A leaf spine", "--sw-pid", str(j.inst.pid)], check=True)
+        print("own SolidWorks PID", j.inst.pid, flush=True)
+        d = build(j, model)
+        data = {"idea": "A: continuous tapered leaf spine", "volume_mm3": volume(d),
+                "mass_g": volume(d) * 0.00119, "bodies": len(bodies(d)), "bbox_mm": bbox(d),
+                "feature_errors": feature_errors(d)}
+        export(j.sw, d, WIP / "idea_a.stl")
+        print(json.dumps(data, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
