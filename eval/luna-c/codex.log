+                    "--status", "C2 idea A channel review", "--sw-pid", str(j.inst.pid)], check=True)
+    d = open_doc(j.sw, WIP / "idea_a.SLDPRT")
+    print({"volume_mm3": volume(d), "bbox_mm": bbox(d)}, flush=True)
+    export(j.sw, d, WIP / "idea_a_groove_partial.stl")

