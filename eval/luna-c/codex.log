+                s.rect((-15.0, y0, -170.0), (15.0, y0, -215.0))
+            # The first 10 mm intersects the bridge, so only 35 mm is new volume.
+            extrude(d, s.feat, label, 6.0, mode=0, want=(1, sign, y0), expect_dv=30 * 35 * 6)
