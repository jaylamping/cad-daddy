new file mode 100644
index 0000000000000000000000000000000000000000..0bbcf9b5ae02875a5bcb2d1715b858d84265dec1
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-c/c2_checkpoint.py
@@ -0,0 +1,35 @@
+"""Crude whole-form C2 checkpoint made from C1 with the long beam corners softened."""
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[5]
+TOOLS = ROOT / "tools" / "solidworks"
+WIP = ROOT / "cad" / "_wip" / "sw-eval" / "luna-c"
+sys.path.insert(0, str(TOOLS))
+from swkit import bbox, bodies, edges_where, export, feature_errors, fillet, job, open_doc, save, save_as
+
+
+def main():
+    target = WIP / "checkpoint_01.SLDPRT"
+    with job(wait_s=1800) as j:
+        subprocess.run([sys.executable, str(ROOT / "tools" / "pc" / "claims.py"), "beat", "sw-eval-luna-c",
+                        "--status", "C2 checkpoint 01", "--sw-pid", str(j.inst.pid)], check=True)
+        print("own SolidWorks PID", j.inst.pid, flush=True)
+        d = open_doc(j.sw, WIP / "link_boxy.SLDPRT")
+        corners = edges_where(d, lambda p: min(abs(p[0] - 20), abs(p[0] + 20)) < 0.02
+                              and min(abs(p[1] - 15), abs(p[1] + 15)) < 0.02
+                              and -169.9 <= p[2] <= -32.1)
+        print("beam corner edges", len(corners), flush=True)
+        r = fillet(d, corners, (4.0, 3.0), "SOFT_BEAM_CORNERS")
+        if r is None:
+            raise RuntimeError("checkpoint corner round did not build")
+        save(d)
+        save_as(d, target)
+        export(j.sw, d, WIP / "checkpoint_01.stl")
+        print({"rounded_mm": r, "volume_mm3": sum(b[1] for b in bodies(d)),
+               "bbox_mm": bbox(d), "feature_errors": feature_errors(d)}, flush=True)
+
+
+if __name__ == "__main__":
+    main()

