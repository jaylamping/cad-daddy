# ---- planes and sketches -----------------------------------------------------------------------------------------------

def plane(d, axis, off, name):
    """The plane normal to model axis 'X', 'Y' or 'Z' at that coordinate (mm). Offset 0 returns the base plane."""
    base = d.FeatureByName(BASE[axis])
    if base is None:
        raise Failed(f'no "{BASE[axis]}" in this part (a template in another language renames the base planes)')
    if abs(off) < 1e-9:
        return base
    d.ClearSelection2(True)
    base.Select2(False, 0)
    p = d.FeatureManager.InsertRefPlane(8 + (256 if off < 0 else 0), abs(off) * m, 0, 0, 0, 0)      # 8 distance, 256 flip
    if p is None:
        raise Failed('plane failed: ' + name)
    p.Name = name
    return p


class Sk:
    """with Sk(d, plane, name) as s: draw with 3D model points in mm; they are mapped into the sketch for you.

    The points go through the sketch's own ModelToSketchTransform, so it never matters which way a plane's sketch axes
    point or whether the plane was flipped. A point that does not lie on the sketch plane raises: that is the plane at
    the wrong offset, caught before it becomes a feature in the wrong place. s.feat is the finished sketch.
    """

    def __init__(self, d, pl, name):
        self.d, self.pl, self.name = d, pl, name

    def __enter__(self):
        d = self.d
        d.ClearSelection2(True)
        self.pl.Select2(False, 0)
        d.SketchManager.InsertSketch(True)
        sk = d.GetActiveSketch2
        if sk is None:
            raise Failed('sketch did not open: ' + self.name)
        self.T = sk.ModelToSketchTransform.ArrayData
        d.SketchManager.AddToDB = True       # straight to the database: no snapping or inferred relations to move points
        return self

    def p(self, q):
        T = self.T
        x, y, z = q[0] * m, q[1] * m, q[2] * m
        w = x * T[2] + y * T[5] + z * T[8] + T[11]
        if abs(w) > 1e-6:
            raise Failed(f'{self.name}: point {tuple(q)} is {abs(w) / m:.4f} mm off the sketch plane')
        return x * T[0] + y * T[3] + z * T[6] + T[9], x * T[1] + y * T[4] + z * T[7] + T[10]

    def poly(self, pts, closed=True):
        P = [self.p(q) for q in pts]
        for a, b in zip(P, (P[1:] + P[:1]) if closed else P[1:]):
            if self.d.SketchManager.CreateLine(a[0], a[1], 0, b[0], b[1], 0) is None:
                raise Failed(f'{self.name}: line not drawn (two points closer than 1e-5 mm?)')

    def rect(self, a, b):
        """Axis-aligned rectangle between opposite corners a and b, which must lie on the sketch plane."""
        k = [i for i in range(3) if abs(a[i] - b[i]) > 1e-9]
        if len(k) != 2:
            raise Failed(f'{self.name}: rect corners must differ in exactly two coordinates')
        c, e = list(a), list(a)
        c[k[0]], e[k[1]] = b[k[0]], b[k[1]]
        self.poly([a, c, b, e])

    def circle(self, c, r):
        a = self.p(c)
        if self.d.SketchManager.CreateCircleByRadius(a[0], a[1], 0, r * m) is None:
            raise Failed(f'{self.name}: circle not drawn')

    def arc(self, c, p0, p1, direction):
        """Arc about centre c from p0 to p1. direction +1 is counter-clockwise seen in the sketch's own axes, which may be
        mirrored against the model's: give the feature its expect_dv, and flip the sign if the volume is wrong."""
        a, b, e = self.p(c), self.p(p0), self.p(p1)
        self.d.SketchManager.CreateArc(a[0], a[1], 0, b[0], b[1], 0, e[0], e[1], 0, direction)

    def spline(self, pts, closed=True):
        arr = []
        for q in list(pts) + (list(pts[:1]) if closed else []):
            u, v = self.p(q)
            arr += [u, v, 0.0]
        if self.d.SketchManager.CreateSpline2(VARIANT(pythoncom.VT_ARRAY | pythoncom.VT_R8, arr), True) is None:
            raise Failed(f'{self.name}: spline not drawn')

    def centerline(self, a, b):
        """The axis for a revolve."""
        p, q = self.p(a), self.p(b)
        self.d.SketchManager.CreateCenterLine(p[0], p[1], 0, q[0], q[1], 0)

    def __exit__(self, et, ev, tb):
        self.d.SketchManager.AddToDB = False
        self.d.InsertSketch2(True)
        if et is None:
            self.feat = self.d.FeatureByPositionReverse(0)
            self.feat.Name = self.name + '_SK'


# ---- features ----------------------------------------------------------------------------------------------------------

def extrude(d, sk, name, depth, cut=False, mode=BLIND, want=None, min_dv=1.0, expect_dv=None):
    """Extrude a sketch (cut=True removes material) and check what it did.

    mode MID extrudes depth in total, half each side of the sketch plane: nothing to get backwards, so put the sketch
    plane at the middle of the feature whenever you can. BLIND goes depth one way; THRU_ALL cuts one way, and both ways are tried until the volume moves the right way.
    For BLIND and UP_TO_NEXT both directions are tried, and want = (axis index 0/1/2, sign, plane coordinate mm) keeps
    the one whose new faces lie on that side of the sketch plane.
    Raises unless the volume changed by more than min_dv mm3 the right way, and, when expect_dv is given, by that
    amount within 1 %.
    """
    fm = d.FeatureManager
    dep = abs(depth) * m
    for rev in ((False,) if mode == MID else (False, True)):
        v0 = volume(d)
        d.ClearSelection2(True)
        sk.Select2(False, 0)
        if cut:
            f = fm.FeatureCut4(True, False, rev, mode, 0, dep, dep, False, False, False, False, 0, 0, False, False, False,
                               False, False, False, True, False, False, False, 0, 0, False, False)
        else:
            f = fm.FeatureExtrusion3(True, False, rev, mode, 0, dep, dep, False, False, False, False, 0, 0, False, False,
                                     False, False, True, False, True, 0, 0, False)
            if f is None:      # auto-select merge fails on some multi-body states; feature scope without it works
                d.ClearSelection2(True)
                sk.Select2(False, 0)
                f = fm.FeatureExtrusion3(True, False, rev, mode, 0, dep, dep, False, False, False, False, 0, 0, False,
                                         False, False, False, True, True, False, 0, 0, False)
        if f is None:
            continue
        d.ForceRebuild3(False)
        dv = (v0 - volume(d)) if cut else (volume(d) - v0)
        ok = dv > min_dv
        if ok and want is not None:
            ax, sign, c0 = want
            vals = []
            for fc in (call(f, 'GetFaces') or []):
                b = call(fc, 'GetBox')
                vals += [b[ax] * 1e3, b[ax + 3] * 1e3]
            ok = bool(vals) and (sum(vals) / len(vals) - c0) * sign > 0
        if ok:
            if expect_dv is not None:
                expect(name + ' volume change', dv, expect_dv, 0.01)
            f.Name = name
            log(f'{name}: {"cut" if cut else "added"} {dv:.2f} mm3')
            return f
        d.EditUndo2(1)

    min_dv: the smallest volume in mm3 the cut must remove (lower it to trim a sliver)."""
    c = at - keep_sign * span / 2
    i = 'XYZ'.index(axis)
    a, b = [-span] * 3, [span] * 3
    a[i] = b[i] = c
    with Sk(d, plane(d, axis, c, name + '_P'), name) as s:
        s.rect(a, b)
    return extrude(d, s.feat, name, span, cut=True, mode=MID, min_dv=min_dv)


def insert_body(d, part_path):
    """Bring another part's solid in as an extra body, at the same coordinates (multi-body models for contact FEA).

    The body stays separate even where it overlaps one already there (measured 2026-11-12), so nothing here tells you
    about an overlap: check for it yourself. The part must hold exactly one solid body.
    """
    n0 = len(solid_bodies(d))
    f = d.InsertPart3(str(part_path), 1, '')       # 1 = swInsertPartImportSolids
    d.ForceRebuild3(False)
    if f is None or len(solid_bodies(d)) != n0 + 1:
        raise Failed(f'{part_path} did not come in as its own body (bodies {bodies(d)})')
    return f


def delete_body(d, name):
    d.ClearSelection2(True)
    if not d.Extension.SelectByID2(name, 'SOLIDBODY', 0, 0, 0, False, 0, NUL, 0):
        raise Failed('no body ' + name)
    f = d.FeatureManager.InsertDeleteBody2(False)
    d.ForceRebuild3(False)
    return f


def single_body(d, crumb_mm3=0.2):
    """Delete crumbs under crumb_mm3 and stop unless exactly one solid body is left: the state every print part must be in."""
    for b in bodies(d):
        if b[1] < crumb_mm3:
            delete_body(d, b[0])
    if len(bodies(d)) != 1:
        raise Failed(f'expected one body, got {bodies(d)}')


# ---- faces: pick by geometry -------------------------------------------------------------------------------------------



def pick(d, kind=None, r=None, inside=None, normal=None, at=None, area=None, tol=0.02):
    """Faces matching every given filter. Stop and print list_faces(d) if a pick returns the wrong count.

    kind 'cyl' or 'plane'; r: cylinder radius mm (within tol); inside: [x0, y0, z0, x1, y1, z1] the face's box must lie
    within; normal: (nx, ny, nz) of a planar face (within 0.01); at: a point (mm) that must lie on the face (0.05 mm);
    area: mm2, within 5 %.
    """
    out = []
    for f in faces(d):
        i = face_info(f)
        if kind and i['kind'] != kind:
            continue
        if r is not None and (i['r'] is None or abs(i['r'] - r) > tol):
            continue
        if inside is not None and not all(i['box'][k] >= inside[k] - tol and i['box'][k + 3] <= inside[k + 3] + tol for k in range(3)):
            continue
        if normal is not None and (i['normal'] is None or max(abs(a - b) for a, b in zip(i['normal'], normal)) > 0.01):
            continue
        if area is not None and abs(i['area'] - area) > 0.05 * area:
            continue
        if at is not None:
            q = f.GetClosestPointOn(at[0] * m, at[1] * m, at[2] * m)
            if q is None or math.dist([v * 1e3 for v in list(q)[:3]], at) > 0.05:
                continue
        out.append(f)
    return out


def list_faces(d, limit=200):
    """Print every face's kind, radius or normal, area and box: how to find out what a pick should ask for."""
    for k, f in enumerate(faces(d)[:limit]):
        i = face_info(f)
        print(k, i['kind'], 'r' if i['r'] is not None else 'n', round(i['r'], 3) if i['r'] is not None else i['normal'],
              'area', round(i['area'], 2), 'box', [round(v, 2) for v in i['box']], flush=True)
# 7. Done means

The first benchmark runs (2026-11-13, [EVAL.md](EVAL.md)) showed that a session with these pages gets the same numbers as
the strongest model. What differed was how far each went after the numbers were right: one stopped at "it passes", the
other asked what the answer was hiding and what it would do next. This page turns that second habit into steps. They are
required, not optional extras: a report that skips one says so and says why.

## Predict, then run

Before every solve, write three numbers in the script's log: the node count you expect (about 12 times the volume
over the element size cubed, both in mm, on a plain part; half as many again with local refinement), the
displacement, and where the peak should be (both from the hand estimate). After the solve compare.

| Off by | Do |
| --- | --- |
| nodes more than 2 times, displacement more than 3 times, or the peak on a feature you did not expect | **stop.** Do not read the stresses. Find out why first: wrong faces (read the fixture and load boxes `static()` logs), a loose body, a unit, a stale pick |
| less than that | go on, and put the comparison in the report |

**Why:** a study that solved the wrong problem still returns a clean reaction and a plausible picture. The only thing that
catches it is a number written down beforehand. Same for modelling: `expect_dv` on every feature you can compute.

## A model is done when

1. Volume, box and body count match the hand values, and the rebuild has no errors.
2. **Every dimension in the specification was measured on the finished solid,** not inferred from the volume: each hole
   centre and radius (`pick` + `face_info`), each face position. A hole in the wrong place has the right volume.
3. **The specification itself was checked:** every wall at least 0.6 mm, every hole inside its material, edge distances at
   least one hole diameter, nothing that cannot be printed or assembled, no two requirements that contradict. Build what
   was asked, and list what you would question, with the numbers.
4. Exports are checked as in [04-export.md](04-export.md).

## A study is done when

1. The five checks in [05-fea.md](05-fea.md) have numbers.
2. **The support was tried a second way** whenever the first one hides a stress that rises with refinement (a fixed hole
   wall, a fixed edge): a ring under the screw head, a bonded washer, a longer fixed face. Report both; the numbers that
   agree between them are the result.
3. **The load was tried a second way** whenever it is rigid (`'remote'`) or sits beside a hole, slot or thin wall: on
   the faces that really bear, or as an even force. Report the higher. Two benchmark runs passed a bracket that fails
   because a rigid load stiffened the wall round the screw holes ([05-fea.md](05-fea.md)).
4. **All three failure measures are reported,** each with its place and its factor: von Mises against yield, tension across
   layers, shear between layers (`layer_stress`, `layer_shear`).
5. **Every print direction the part could be made in is read from the same result,** as a table of the three measures.
   Whether or not a direction was given: if another one is better, say so and by how much.
6. Convergence followed the governing measure, not only von Mises (`converge(..., layers=normal)`), over three sizes.
   **A verdict of pass needs every one of the three measures converged.** If one still moves by more than 5 % at the
   last refinement, the verdict is "not shown", never pass on the finest value. The measure is climbing at a sharp
   edge: give that edge the radius the printed part will have (0.4 mm if nothing says otherwise, or the fillet the
   neighbouring edges have), solve again, and judge that. On the second benchmark set this was the one place the
   two models parted: same numbers, one passed the bracket on a climbing value, the other rounded the edge and found
   1.88 against 2.0.
7. The load path was followed in a sentence: which faces bear, which section carries it, where it leaves.
8. For contact: the proof that the set is contact and not a bond (reverse a tiny load: the bodies must part), the share
   the pads carry, and the contact force summed from the results against the applied load.

## "It passes" is not the end

When the requirement is met, the report still has these three, each with a number:

- **The thinnest margin** and what would eat it (a load 20 % higher, the other print direction, a sharper corner as
  printed).
- **The cheapest improvement you found** (mass, margin, print time, fewer supports), even if nobody asked: a direction to
  print it in, a radius, a wall. Try it if it takes under ten minutes; otherwise size it by hand.
- **What you did not check** that a reviewer would ask about.

When the requirement is not met, do not stop at "fail". Try the changes in this order, cheapest first, and show the one
that works: print direction, a radius at the peak, material where the stress is, a different load path.

When asked to make something better with no stated end (lighter, stiffer), keep going until two more steps in a row gain
under 3 %, or a requirement stops you. Say which requirement governs at the end: if none is at its limit, you stopped
early.

## Long jobs: show the work early

A job that will take more than an hour does not run to the end unseen. The cost of a wrong direction is the time until
somebody looks, so make that time short.

1. **Before modelling, restate the ask** in five lines: what the part is for, the faces and dimensions that are fixed,
   what "good" means for this part (the look, the mass, the factor), and what is yours to choose. If you cannot write
   the "good" line, ask before you start.
2. **First checkpoint within 20 minutes:** the crudest version that shows the whole shape (every body, every interface,
   right size, no detail), with pictures from all sides (`python tools/solidworks/sheet.py part.stl`; open the PNG and
   look at it) and the volume. Commit it and report it (when you are working alone and were told to commit once at
   the end, the picture and one line in the report with the time are the checkpoint). Go on without waiting,
   but a reply that changes the direction wins over everything done since.
3. **A time budget per stage,** written at the start (shape, detail, study, report). At the end of each stage report in
   three lines: done, measured against the ask, next. A stage that runs past twice its budget stops and reports why.
4. **Compare with the ask, not with your last version.** At every checkpoint put the picture beside the reference or the
   written ask and list what is still missing. "Better than an hour ago" is not a measure.
5. **Never report a stage as done on effort.** Done is the list above for a model or a study; a part that is 60 % there
   is reported as 60 % there, with what the rest needs.

**Why:** the failure this prevents is four hours of work on a part nobody would have accepted at minute twenty.

## Before you hand a problem up

Handing up is right for the cases in [06-judgment.md](06-judgment.md). It is wrong as a way out of a hard step. Before
you do:

1. Three attempts that differ in kind, not in a parameter, each with what it ruled out.
2. The smallest case that still shows the problem (one body less, a coarser mesh, a simpler load).
3. A guess at the cause, and the one experiment that would test it.

Then hand up all of that. Most of the time step 2 finds the answer.

## The last ten minutes

Before writing the report, read your own results as a reviewer who wants to find the mistake:

- Which number here would I least like to be asked about? Go and check that one.
- Did anything surprise me that I explained away without testing? Test it.
- If the part were built from this report and broke, where would it break, and did I look there?
- Is there a small hole, a slot or a thin wall in a stressed region that my masks or my mesh never looked at?

