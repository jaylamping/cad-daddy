diff --git a/tools/solidworks/playbook/eval/luna-a/t2.py b/tools/solidworks/playbook/eval/luna-a/t2.py
new file mode 100644
index 0000000000000000000000000000000000000000..270caf6ac8eea87512026479611caaaafe7350ed
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-a/t2.py
@@ -0,0 +1,142 @@
+"""T2: open the saved T1 native part, then add four counterbores and one rounded slot."""
+import json
+import math
+import sys
+from pathlib import Path
+
+import trimesh
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / "cad" / "_wip" / "sw-eval" / "luna-a"
+sys.path.insert(0, str(ROOT / "tools" / "solidworks"))
+from swkit import MID, Sk, bbox, bodies, call, close, expect, export, extrude, feature_errors, job, open_doc, plane, save, save_as, single_body, volume
+
+
+def main():
+    source = CAD / "bracket.SLDPRT"
+    target = CAD / "bracket_b.SLDPRT"
+    target.unlink(missing_ok=True)
+    hand_t1 = (
+        36000 + 50 * 4**2 * (1 - math.pi / 4)
+        - 4 * 6 * 5**2 * (1 - math.pi / 4)
+        - 4 * math.pi * 2.75**2 * 6
+        - math.pi * 11**2 * 6
+        - 4 * math.pi * 1.7**2 * 6
+    )
+    cb_cut = 4 * math.pi * (5**2 - 2.75**2) * 3
+    slot_area = (20 - 6) * 6 + math.pi * 3**2
+    slot_cut = slot_area * 6
+    hand_t2 = hand_t1 - cb_cut - slot_cut
+
+    with job(wait_s=1800) as j:
+        d = open_doc(j.sw, source)
+        expect("opened T1 bracket native volume", volume(d), hand_t1, 0.001)
+        expect("opened T1 one-body count", len(bodies(d)), 1, 0)
+        expect("opened T1 feature errors", len(feature_errors(d)), 0, 0)
+        save_as(d, target)
+
+        with Sk(d, plane(d, "Z", 4.5, "COUNTERBORES_P"), "COUNTERBORES") as s:
+            for x, y in ((25, 10), (25, 40), (65, 10), (65, 40)):
+                s.circle((x, y, 4.5), 5.0)
+        extrude(d, s.feat, "COUNTERBORES", 3.0, cut=True, mode=MID, expect_dv=cb_cut)
+        save(d)
+
+        # A single closed capsule: straight sections are 14 mm, end radii are 3 mm.
+        with Sk(d, plane(d, "Z", 3.0, "SLOT_P"), "SLOT") as s:
+            s.poly([(38, 22, 3), (52, 22, 3)], closed=False)
+            s.arc((52, 25, 3), (52, 22, 3), (52, 28, 3), +1)
+            s.poly([(52, 28, 3), (38, 28, 3)], closed=False)
+            s.arc((38, 25, 3), (38, 28, 3), (38, 22, 3), +1)
+        extrude(d, s.feat, "SLOT", 6.0, cut=True, mode=MID, expect_dv=slot_cut)
+        save(d)
+
+        single_body(d)
+        expect("T2 volume mm3", volume(d), hand_t2, 0.001)
+        expect("T2 feature errors", len(feature_errors(d)), 0, 0)
+        expected_box = (0, 0, 0, 80, 50, 46)
+        for i, want in enumerate(expected_box):
+            expect(f"T2 bbox[{i}] mm", bbox(d)[i], want, 0.01)
+
+        counterbore_faces = []
+        for x, y in ((25, 10), (25, 40), (65, 10), (65, 40)):
+            fs = [f for f in j_faces(d) if is_cylinder(f, 5.0, box=(x, y))]
+            if len(fs) != 1:
+                raise RuntimeError(f"expected one Ø10 counterbore wall at {(x, y)}, got {len(fs)}")
+            counterbore_faces.extend(fs)
+            floors = [f for f in j_faces(d) if on_floor(f, x + 4.0, y, 3.0)]
+            if not floors:
+                raise RuntimeError(f"counterbore floor at {(x, y)} was not measured")
+            zlo = min(call(f, "GetBox")[2] for f in floors) * 1000
+            zhi = max(call(f, "GetBox")[5] for f in floors) * 1000
+            expect(f"counterbore floor z at {(x, y)} mm", (zlo + zhi) / 2, 3.0, 0.03)
+        if len(counterbore_faces) != 4:
+            raise RuntimeError(f"expected four counterbore walls, got {len(counterbore_faces)}")
+
+        slot_faces = [f for f in j_faces(d) if is_cylinder(f, 3.0, box=None)]
+        # Exclude the original radius-2.75 and radius-1.7 holes by exact radius; this selection is the two slot ends.
+        slot_faces = [f for f in slot_faces if slot_box(f)]
+        if len(slot_faces) != 2:
+            raise RuntimeError(f"expected two rounded slot end faces, got {len(slot_faces)}")
+        slot_boxes = sorted([[v * 1000 for v in call(f, "GetBox")] for f in slot_faces], key=lambda b: b[0])
+        expect("slot total length mm", slot_boxes[1][3] - slot_boxes[0][0], 20.0, 0.03)
+        expect("slot width mm", slot_boxes[0][4] - slot_boxes[0][1], 6.0, 0.03)
+        expect("slot through thickness mm", max(b[5] for b in slot_boxes) - min(b[2] for b in slot_boxes), 6.0, 0.03)
+
+        save(d)
+        export(j.sw, d, CAD / "bracket_b.stl")
+        native_volume = volume(d)
+        close(j.sw, d)
+
+    mesh = trimesh.load(CAD / "bracket_b.stl", force="mesh")
+    if not mesh.is_watertight or len(mesh.split(only_watertight=False)) != 1:
+        raise RuntimeError("T2 STL is not one watertight shell")
+    expect("T2 STL volume mm3", float(mesh.volume), hand_t2, 0.005)
+    result = {
+        "volume_mm3": native_volume,
+        "hand_volume_mm3": hand_t2,
+        "counterbore_floor_z_mm": 3.0,
+        "bodies": 1,
+        "stl_watertight": bool(mesh.is_watertight),
+        "stl_volume_mm3": float(mesh.volume),
+    }
+    (RUN / "t2_result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2), flush=True)
+
+
+def j_faces(d):
+    return [f for b in (d.GetBodies2(0, True) or []) for f in (call(b, "GetFaces") or [])]
+
+
+def is_cylinder(f, radius, box=None):
+    s = f.GetSurface
+    if not s.IsCylinder or abs(s.CylinderParams[6] * 1000 - radius) > 0.02:
+        return False
+    b = [min(call(f, "GetBox")[i], call(f, "GetBox")[i + 3]) * 1000 for i in range(3)]
+    q = [max(call(f, "GetBox")[i], call(f, "GetBox")[i + 3]) * 1000 for i in range(3)]
+    if radius == 3.0:
+        return True
+    return box is None or (abs((b[0] + q[0]) / 2 - box[0]) < 0.05 and abs((b[1] + q[1]) / 2 - box[1]) < 0.05)
+
+
+def slot_box(f):
+    b = [min(call(f, "GetBox")[i], call(f, "GetBox")[i + 3]) * 1000 for i in range(3)]
+    q = [max(call(f, "GetBox")[i], call(f, "GetBox")[i + 3]) * 1000 for i in range(3)]
+    return b[0] >= 34.9 and q[0] <= 55.1 and b[1] >= 21.9 and q[1] <= 28.1 and b[2] >= -0.1 and q[2] <= 6.1
+
+
+def on_floor(f, x, y, z):
+    if not f.GetSurface.IsPlane:
+        return False
+    n = list(f.Normal)
+    if abs(n[2]) < 0.99:
+        return False
+    b = call(f, "GetBox")
+    if abs((b[2] + b[5]) * 500 - z) > 0.03:
+        return False
+    q = f.GetClosestPointOn(x / 1000, y / 1000, z / 1000)
+    return q is not None and math.dist([v * 1000 for v in list(q)[:3]], [x, y, z]) < 0.05
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/solidworks/playbook/eval/luna-a/t3.py b/tools/solidworks/playbook/eval/luna-a/t3.py
new file mode 100644
index 0000000000000000000000000000000000000000..e11575961a19d483b9d61e89d1eb4c3688638fdf
--- /dev/null
+++ b/tools/solidworks/playbook/eval/luna-a/t3.py
@@ -0,0 +1,187 @@
+"""T3: converged bracket study, with a second even-force load representation."""
+import hashlib
+import json
+import math
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[5]
+RUN = Path(__file__).resolve().parent
+CAD = ROOT / "cad" / "_wip" / "sw-eval" / "luna-a"
+MODEL = CAD / "bracket.SLDPRT"
+sys.path.insert(0, str(ROOT / "tools" / "solidworks"))
+from swfea import PETG, converge, static
+from swkit import call, expect, job, open_doc, pick
+
+
+HAND_VOLUME = (
+    36000 + 50 * 4**2 * (1 - math.pi / 4)
+    - 4 * 6 * 5**2 * (1 - math.pi / 4)
+    - 4 * math.pi * 2.75**2 * 6
+    - math.pi * 11**2 * 6
+    - 4 * math.pi * 1.7**2 * 6
+)
+HAND_STRESS = 150 * (28 - 6) / (50 * 6**2 / 6)
+HAND_DISP = 150 * (28 - 6) ** 3 / (3 * 1900 * (50 * 6**3 / 12))
+SIZES = (4.0, 3.0, 2.5)
+MASK_DISTANCE = 2 * max(SIZES)
+
+
+def log_prediction(el, case):
+    expected_nodes = round(12 * HAND_VOLUME / el**3 * 1.5)
+    print(
+        f"PREDICT {case}: el={el:.2f} mm, nodes~{expected_nodes}, "
+        f"displacement~{HAND_DISP:.3f} mm, peak at the inside R4 junction along Y",
+        flush=True,
+    )
+    return expected_nodes
+
+
+def write_task_result(result):
+    path = RUN / "results.json"
+    all_results = json.loads(path.read_text(encoding="utf-8"))
+    for item in all_results:
+        if item["task"] == "T3":
+            item.update(result)
+            break
+    path.write_text(json.dumps(all_results, indent=2) + "\n", encoding="utf-8")
+    (RUN / "t3_result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+
+
+def main():
+    print("MODEL_SHA256", hashlib.sha256(MODEL.read_bytes()).hexdigest(), flush=True)
+    print(f"HAND root stress={HAND_STRESS:.4f} MPa, displacement={HAND_DISP:.4f} mm", flush=True)
+    with job(wait_s=1800) as j:
+        j.simulation()
+        d = open_doc(j.sw, MODEL)
+        d.ForceRebuild3(False)
+
+        def setup():
+            d.ForceRebuild3(False)
+            fixtures = pick(d, kind="cyl", r=2.75)
+            bore = pick(d, kind="cyl", r=11.0)
+            root = pick(d, kind="cyl", r=4.0)
+            front = pick(d, kind="plane", normal=(-1, 0, 0), at=(0, 5, 28))
+            if len(fixtures) != 4 or len(bore) != 1 or len(root) != 1 or len(front) != 1:
+                raise RuntimeError(
+                    f"pick counts: screw walls={len(fixtures)}, bore={len(bore)}, "
+                    f"inside R4={len(root)}, front face={len(front)}"
+                )
+            controls = [(root, 1.5), (fixtures, 2.0), (bore, 2.0)]
+            return fixtures, bore, root, front, controls
+
+        def primary(el):
+            predicted = log_prediction(el, "T3 bore remote")
+            fixtures, bore, _, _, controls = setup()
+            r = static(
+                j,
+                d,
+                f"T3_REMOTE_{el:g}",
+                PETG,
+                fixtures=[("fixed", fixtures)],
+                loads=[("remote", bore, (3, 25, 28), (150, 0, 0), (0, 0, 0))],
+                el=el,
+                ctrl=controls,
+                max_nodes=200_000,
+            )
+            if r.nodes < predicted / 2 or r.nodes > predicted * 2:
+                raise RuntimeError(f"node count {r.nodes} is over 2x away from prediction {predicted}; do not judge stresses")
+            if r.max_disp() is None or not HAND_DISP / 3 <= r.max_disp() <= HAND_DISP * 3:
+                raise RuntimeError(f"displacement {r.max_disp()} mm is over 3x away from hand estimate {HAND_DISP:.4f} mm")
+            expect(f"{r.name} reaction Fx N", r.reaction[0], -150.0, 0.01)
+            expect(f"{r.name} reaction resultant N", r.reaction[3], 150.0, 0.01)
+            primary.last_result = r
+            return r
+
+        primary.last_result = None
+        rows, converged = converge(primary, SIZES, tol=0.05, layers=(0, 0, 1))
+        # Recompute and retain the finest run once more is unnecessary: converge's final result is captured by the closure.
+        fine = primary.last_result
+        if fine is None:
+            raise RuntimeError("converge did not retain its final result")
+        keep = fine.away(dist=MASK_DISTANCE)
+        vm, at = fine.peak(keep)
+        layer_z, layer_z_at = fine.layer_stress((0, 0, 1), keep)
+        shear_z, shear_z_at = fine.layer_shear((0, 0, 1), keep)
+        directions = {}
+        for label, normal in (("X", (1, 0, 0)), ("Y", (0, 1, 0)), ("Z", (0, 0, 1))):
+            tension, p_t = fine.layer_stress(normal, keep)
+            shear, p_s = fine.layer_shear(normal, keep)
+            directions[label] = {
+                "tension_mpa": tension,
+                "tension_at_mm": p_t,
+                "shear_mpa": shear,
+                "shear_at_mm": p_s,
+                "sf_tension": 22.5 / tension if tension > 0 else None,
+                "sf_shear": 13.0 / shear if shear > 0 else None,
+            }
+        np.savez_compressed(RUN / "t3_fine_nodes.npz", pos=fine.pos, stress_mpa=fine.s, disp_mm=fine.disp)
+
+        # T4th study slot used for the playbook's second-load check: the motor mounting face gets
+        # the same +X resultant as an even tensile traction instead of a rigid remote coupling to the bore.
+        predicted = log_prediction(SIZES[0], "T3 even front-face traction")
+        fixtures, _, _, front, controls = setup()
+        alt = static(
+            j,
+            d,
+            "T3_FRONT_TRACTION",
+            PETG,
+            fixtures=[("fixed", fixtures)],
+            loads=[("normal", front, -150.0)],
+            el=SIZES[0],
+            ctrl=controls,
+            max_nodes=200_000,
+        )
+        if alt.nodes < predicted / 2 or alt.nodes > predicted * 2:
+            raise RuntimeError(f"alternate load node count {alt.nodes} is over 2x from prediction {predicted}")
+        expect("front traction reaction Fx N", alt.reaction[0], -150.0, 0.01)
+        expect("front traction reaction resultant N", alt.reaction[3], 150.0, 0.01)
+        alt_keep = alt.away(dist=MASK_DISTANCE)
+        alt_vm, alt_at = alt.peak(alt_keep)
+        alt_layer, alt_layer_at = alt.layer_stress((0, 0, 1), alt_keep)
+        alt_shear, alt_shear_at = alt.layer_shear((0, 0, 1), alt_keep)
+        print("ALTERNATE_LOAD", json.dumps({
+            "el_mm": alt.el, "nodes": alt.nodes, "peak_vm_mpa": alt_vm, "peak_at_mm": alt_at,
+            "layer_z_mpa": alt_layer, "layer_z_at_mm": alt_layer_at,
+            "layer_shear_z_mpa": alt_shear, "layer_shear_z_at_mm": alt_shear_at,
+        }), flush=True)
+
+    yield_mpa = max(vm, alt_vm)
+    layer_mpa = max(layer_z, alt_layer)
+    shear_mpa = max(shear_z, alt_shear)
+    sf_yield = 45.0 / yield_mpa if yield_mpa > 0 else None
+    sf_layer = 22.5 / layer_mpa if layer_mpa > 0 else None
+    verdict = "pass" if converged and sf_yield >= 2.0 and sf_layer >= 2.0 else "fail"
+    result = {
+        "hand_root_stress_mpa": HAND_STRESS,
+        "el_mm": SIZES[-1],
+        "nodes": fine.nodes,
+        "peak_vm_mpa": vm,
+        "peak_at_mm": at,
+        "layer_stress_mpa": layer_z,
+        "sf_yield": sf_yield,
+        "sf_layer": sf_layer,
+        "max_disp_mm": fine.max_disp(),
+        "reaction_n": float(fine.reaction[3]),
+        "converged": bool(converged),
+        "convergence_rows": [list(row) for row in rows],
+        "verdict": verdict,
+        "status": "done" if converged else "partial",
+        "notes": (
+            f"Layer shear along Z={shear_z:.3f} MPa at {shear_z_at}; "
+            f"support is fixed on the four Ø5.5 screw-hole walls; peaks are reported at least "
+            f"{MASK_DISTANCE:g} mm from fixture and load nodes. Alternate even front-face traction: "
+            f"vm={alt_vm:.3f} MPa, Z tension={alt_layer:.3f} MPa, Z shear={alt_shear:.3f} MPa. "
+            f"Controlling support/load results use the higher of the bore remote and even face traction; "
+            f"direction table: {json.dumps(directions)}. Layer Z peak at {layer_z_at}; "
+            f"shear Z peak at {shear_z_at}."
+        ),
+    }
+    write_task_result(result)
+    print(json.dumps(result, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()

